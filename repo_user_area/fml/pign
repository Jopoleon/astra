! PIGN [MW/m#3]: Ion heat power density due to particle flux
! PIGN=5/2*GRAD(V'*Ti*ni/ne*GN)/V'[/625]
! Use: PI=-PIGN   (Pereverzev 26-OCT-90)
!  Use this formula for output only. 
! 5/2*div(Ti*GNi) should be included in equations by defining
! coefficients DN, HN, XN or CN or by defining flux GNX
if (J .gt. 1 .and. J .lt. NA1) PIGN=(GN(J)*(VR(J)+VR(J+1))  *(TI(J+1)+TI(J))*(NI(J+1)+NI(J))/(NE(J+1)+NE(J))-GN(J-1)*  (VR(J)+VR(J-1))*(TI(J)+TI(J-1))*(NI(J)+NI(J-1))/  (NE(J)+NE(J-1)))/(1000.*HRO*VR(J))
if (J .eq. 1) PIGN=  GN(1)*(TI(2)+TI(1))*(NI(2)+NI(1))/(NE(2)+NE(1))/(250.*HRO)
if (J .ge. NA1) PIGN=0.
