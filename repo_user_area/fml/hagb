! HAGB [m#2/s]: Heat conductivity Anomalous gyroBohm
! BOHM=c*Te/(e*B)=TE/BTOR*10^3[m^2/s]
! HAGB=BOHM*(dTe/dr)*a/Te*ro/a; ro=rl_i/omega_ci  
!  Source: M.Erba et al. JET-P(96)10
!    I.Vojtsekhovich 01-08-96
! Usage:  HE=...+0.035*HAGB*XSTEP(0.8);
!  Modif ied by G.Pereverzev 14-JAN-97
!  to include recommended numerical pre-factor 0.035
! Usage:  HE=HATL+HAGB+...
! Usage:  XI=2*HATL+HAGB+...
!     
if ( J .eq. 1 ) then
 YLP = 0.
 YHAGB = .32*SQRT(AMJ)/HRO/BTOR/BTOR/ZMJ
else
 YLP = YHAGB*abs(TE(J)-TE(J-1))/(TE(J)+TE(J-1))
endif 
HAGB = YLP*TE(J)*SQRT(TE(J))
