!C PRarg [MW*m#3] Argon radiation power
!C       POST D.E. JENSEN R.V. e.a. PPPL-1352 1977
!C			(Leonov 13-07-99)
	T=TE(J)*1.e3
	Z=LOG10(TE(J))

	PRKR=-20.

	IF(T.LT.200.AND.T.GE..0055) then
		PRKR=5.675641e1+Z*4.008518e2+Z**2*8.516538e2+ &
     & Z**3*8.893999e2+Z**4*4.547683e2+Z**5*9.121582e1
	endif
	IF(T.LT.2000.AND.T.GE.200) then
		PRKR=-1.813640e1-Z*1.518979+Z**2*2.831872+ &
     & Z**3*6.121357-Z**4*1.079979e1-Z**5*1.574148e1
	endif
	IF(T.LT.20000.and.T.ge.2000)	then
		PRKR=-2.338300e1+Z*3.908789e1-Z**2*1.058863e2+ &
     & Z**3*1.264609e2-Z**4*7.041264e1+Z**5*1.501634e1
	endif
	if(T.gt.20000)	then
		PRKR=-2.639275e1+Z*1.954424e1-Z**2*2.069597e1+ &
     & Z**3*1.093239e1-Z**4*2.881914+Z**5*3.063117e-1
	endif

	PRKR=10.**PRKR*1.e19
