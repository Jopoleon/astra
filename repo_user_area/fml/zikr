!C ZIAR [ ]:	Average Ar charge
!C       POST D.E. JENSEN R.V. e.a. PPPL-1352 1977
!C				(G. Pacher 01-04-1993)
	T=TE(J)*1.e3
	Z=LOG10(TE(J))
	ZIKR=1.
	IF(T.LT.200.AND.T.GE.5.5) then
		ZIKR=2.737397e2+Z*1.421057e3+Z**2*3.108547e3+ &
     & Z**3*3.389628e3+Z**4*1.820894e3+Z**5*3.839507e2
	endif
	IF(T.LT.2000.AND.T.GE.200) then
		ZIKR=2.477348e1+Z*1.092932e1-Z**2*3.98248e1- &
     & Z**3*5.751637+Z**4*1.585362e2+Z**5*1.51381e2
	endif
	IF(T.LT.20000.and.T.ge.2000)	then
		ZIKR=4.204802e1-Z*1.661638e2+Z**2*5.705164e2- &
     & Z**3*7.922043e2+Z**4*4.957932e2-Z**5*1.162575e2
	endif
	if(T.gt.20000)	then
		ZIKR=6.978986e1-Z*1.225901e2+Z**2*1.552172e2- &
     & Z**3*9.332669e1+Z**4*2.742764e1-Z**5*3.189013
	endif
