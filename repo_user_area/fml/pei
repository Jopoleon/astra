! PEI [MW/m#3/keV]: Electron ion heat exchange due to Coulomb collisions
! PEI=3/tauei*Ne*m/M
!  here tauei[sec]=1.1E-3*T_{e, keV}^{3/2}/[Z_i^2*n_{i, 19}*\Lambda]
! PE=...+PEI*TI;  PET=...-PEI
! PI=...+PEI*TE;  PIT=...-PEI
!   (Pereverzev 22-JAN-90)
!   (Corrected  19-JUN-97)
include 'fml/coulg'
PEI=0.00246*COULG*NE(J)*NI(J)*ZMAIN(J)*ZMAIN(J)/   (AMAIN(J)*TE(J)*SQRT(TE(J)))
