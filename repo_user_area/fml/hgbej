! HGBEJ [m#2/s]: GyroBohm term in JET Transport Model 
!   Private communication of 14.01.1999 with a reference to
!  V.V.Parail et al. Plasma Physics and Contr. Fusion,  40 (1998) 805
!    (Implemented by Pereverzev 19-Jan-99)
! HGBJ=0.158*sqrt{Ti}/B^2*grad{Ti}
! Usage:  HE=2*HBJET+HGBEJ+...
!   XI=4*HBJET+.5*HGBEJ+...
!
if (J .eq. 1) then
    YHGBEJ = 0.158/HRO/BTOR**2
    HGBEJ = .0
else
    HGBEJ =YHGBEJ*sqrt(TE(J))*abs(TE(J)-TE(J-1))
endif 
