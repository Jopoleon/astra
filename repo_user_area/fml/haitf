if (J .eq. 1)  YHAITF=1./(.038*IPL**0.85*SQRT(AMAIN(1)*ELONG)  *(BTOR*ABC*RTOR)**.2*RTOR*(ABC*NEAVR(ROC)+.001)**.1)
HAITF=YHAITF*((J-.5)*HRO)**2
