! RLTWN []: R/L_Tcrit for ITG mode  (Weiland Nordman model)
!  according to T.A.Davydova & J.Weiland, Ph.Pl., Vol.7(1) 243 (2000)
! See also RLTCZ & RLTCR (if S/PPPL model)
!      (Pereverzev 26-03-00)
YTAU=TE(j)/TI(j)
include 'fml/lne'
YRLN = RTOR/LNE
RLTWN= 0.667*YRLN-0.5*YTAU+0.25*YTAU+1.1/YTAU+0.25*YTAU*YRLN**2
