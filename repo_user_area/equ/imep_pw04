!DENSITY BLOCK------------------------------------------------------
!Densities sources
NNCL=ZRD40X/1000.0; !Cold neutrals
ENCL = 0.005; ! 5 eV --> Franck-Condon neutrals (as in A. Kallenbach paper)
NNWM=0.; !Warm neutrals

PEBM=car20x;    ! Pe - poh + pei
PIBM=car21x;	! Pi - pei
PEECR=0.0;
PRAD=PRADX;
SNEBM=CAR18X;	!electron source from NBI

NIBM=car19x;   ! total fast ion density NBI+ICRH
PBLON=2./3.*1.E-3/1.6*(0.);  ! total par energy density NBI+ICRH from TRA0
PBPER=2./3.*1.E-3/1.6*(0.);   ! same perp

NEUT:.04:::;
SNN=SNNEU;
SN=SNEBM;
NIZ1=NE*(ZEF-1.D0)/(ZIM1-1.D0)/ZIM1;	!density of impurity
ZIM1=7.;AIM1=14.;
ZIM2=0.;ZIM3=0.;
NIZ2=0.;NIZ3=0.;
NDEUT=NE-ZIM1*NIZ1;	!density of deuterium plasma ions
! NDEUT = NE-NIBM-ZIM1*NIZ1;
NI=NDEUT+NIZ1;
NMAIN=NDEUT;
!------------------------------------------------------------------

!!Power block---------------------
SGNIP= 1.;
SGNBT= -1.;
