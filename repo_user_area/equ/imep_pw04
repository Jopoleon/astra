PEICR = 0.0;
PIICR = 0.0;
PE=POH+PEECR+PEBM-PRAD-PEICL+PEICR;
PI=PIBM+PEICL+PIICR;
------------------------------------

!Neoclassical coefficients
NEOCL4<::::;
CAR60="xd_nc(j)"; !"work(j,165)"; ! heat conductivity Chi_deuteron, [m**2/s]
CAR59="xe_nc(j)"; !"work(j,105)"; ! heat conductivity Chi_electron, [m**2/s]
CAR56="dn_e_nc(j)"; !"work(j,102)"; ! particle diffusion coefficient Dn_electron, [m**2/s]

!TRANSPORT BLOCK-----------------------------------------------

CIMP2 = NEX(AFX(0.2))-NE(AFX(0.2)) - (NEX(AFX(0.82))-NE(AFX(0.82)));

CAR19 = 0.5*(1-XSTEP(CDWM5))+(1-XSTEP(0.25))*0.5; !DN
CAR19 = car19 + 0.75*RTOR*XSTEP(0.7)*(1-XSTEP(CDWM5-0.05));
CAR19 = car19 - FJUMP(CF13)*CIMP2*20*(1-XSTEP(0.7));

SMEARR(CF4*CF9,CAR19,CAR23)::::;


CF7 = CDWM4+CDWM1/2.;
CHE1  = CHI1*0.25;
CAR26 = abs(HEXP)*TEX(AFX(0.85))/TE(AFX(0.85))*(1-XSTEP(0.85));
CAR26 = CAR26 + CHE1 * XSTEP(CDWM4);                !HE
CAR26 = car26 + car59;!* (1-XSTEP(CDWM4))	            !Neoclassical transport
CAR26 = car26 + XSTEP(0.99)*(0.1+2.0*CHE1);           !SOL continuity
!CAR26 = car26 + XSTEP(0.99)*(0.4+3.5*CHE1);           !SOL continuity
CAR26 = car26 + (0.1+1.5*CHE1)*XSTEP(0.85)*(1-XSTEP(CDWM4-0.06))*1.9;
CAR26 = car26 + (0.1+1.5*CHE1)*XSTEP(CDWM4-0.06)*(1-XSTEP(CDWM4-0.04))*4.;
CAR26 = car26 + (0.1+1.5*CHE1)*XSTEP(CDWM4-0.04)*(1-XSTEP(CDWM4-0.02))*2.;
CAR26 = car26 + (0.1+1.5*CHE1)*XSTEP(CDWM4-0.02)*(1-XSTEP(CDWM4))*1.2;
CAR26 = car26*(1-XSTEP(CDWM3)) + XSTEP(CDWM3)*min(3.2,car26);

SMEARR(CF4*CF9,CAR26,CAR30)::::;
CAR33 = car30+10*(1-XSTEP(0.85));

CDWM7=CDWM4;
CAR25 = abs(XEXP)*TIX(AFX(0.85))/TI(AFX(0.85))*(1-XSTEP(0.85));
CAR25 = CAR25 + FRMIN(CAR33) * XSTEP(cdwm7);	          !XI
CAR25 = car25 + min(3.,CAR60); !* (1-XSTEP(cdwm7));     !Neoclassical transport
CAR25 = car25 + XSTEP(0.99)*(0.6+CHE1+CAR33(AFX(CF7)))*0.5;        !SOL continuity
CAR25 = car25 + (0.6+CHE1)*XSTEP(0.85)*(1-XSTEP(cdwm7-0.06))*1.2;
CAR25 = car25 + (0.6+CHE1)*XSTEP(cdwm7-0.06)*(1-XSTEP(cdwm7-0.04))*1.8;
CAR25 = car25 + (0.6+CHE1)*XSTEP(cdwm7-0.04)*(1-XSTEP(cdwm7-0.02))*1.8;
CAR25 = car25 + (0.6+CHE1)*XSTEP(cdwm7-0.02)*(1-XSTEP(cdwm7))*.6;
CAR25 = car25*(1-XSTEP(CDWM3)) + XSTEP(CDWM3)*min(6.5,car25);

CAR27 = -0.05*XSTEP(CDWM5-0.05); !Pedestal pinch

CAR28 = (car56(AFX(CF7)) + CHI2*FRMIN(CAR33))*XSTEP(CDWM5);  	    !DN
CAR28 = CAR28 + car23*(1-XSTEP(CDWM5));

CAR28=car28+(CHI2*0.1 + 1.*car28(AFX(CF7)))*100.*XSTEP(0.99)*(XRHO-(0.99));

SMEARR(CF4*CF9,CAR25,CAR29)::::;

SMEARR(CF5*CF9*2.,CAR27,CAR31)::::;
SMEARR(CF5*CF9*2.,CAR28,CAR32)::::;


XI = abs(HEXP)*(1-FJUMP(CF13)) + FJUMP(CF13)*max(car60,car30);
HE = abs(HEXP)*(1-FJUMP(CF13)) + FJUMP(CF13)*max(car59,car30);
CN = -0.5*(1-FJUMP(CF13)) + FJUMP(CF13)*car31;
DN = 0.01*(1-FJUMP(CF13)) + FJUMP(CF13)*max(car56,car32);


DVE=100*(1-FJUMP(2.))+FJUMP(2.)*80;
DVI=100*(1-FJUMP(2.))+FJUMP(2.)*80;
DVN=200*(1-FJUMP(2.))+FJUMP(2.)*80;


!Transport coefficients other than HE
CE=0.0; CI=0.0;
XE=0.0;
HI=0.0; DI=0.0;
HN=0.0; XN=0.0;
DE=0;

