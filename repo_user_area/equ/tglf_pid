ATREQ = 1.;
!MEQUIL = 0;

TAUMIN=0.05;
TAUMAX=0.05;

AMAIN=AMJ;
ZMAIN=ZMJ;

AIM1=12.; ! C
ZIM1=ZICAR;
NIZ1=CIMP1*NE;
ZIM2=1.e-1;
ZIM3=1.e-1;
!Deuterium density
NDEUT=NE-ZIM1*NIZ1;
NMAIN=NDEUT;
NI=NDEUT+NIZ1;  !Thermal ion density
ZEF1 = ZIM1*(ZIM1-1.)*NIZ1/NE;
