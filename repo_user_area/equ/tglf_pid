! Sources

! Density sources
! feedback loop to guarantee programmed line averaged density

CF1=VINT(NEXB)/VOLUME; ! this is the desired volume averaged density
CF2=VINT(NEB)/VOLUME;  ! this is the current volume averaged density

CNEUT1 = 1.; ! this is the minimum level, one might need to change it in case of conditions with very high ne_sep                       ! compared to ne_averaged (can also go in the log)

CNEUT3 = 0.01; ! initial value of NNCL

! new PID
PID_CONTROL(CSCL1*TAU, CSCL1*TAU*CSCL2, CSCL1*TAU*CSCL3, CF1-CF2, NNCL, CF3)>::::;

NNCL=FJUMP(0.1)*max(1.e-7*CNEUT1,CF3)+(1.-FJUMP(0.1))*CNEUT3; ! cold neutral density
ENCL=CNEUT2; ! between 2 and 10 eV (now it's 5 eV = 0.005 keV)

NEUT>::::; ! calculates neutral density NN and temperature TN

! ECH: TORBEAM, NBI: RABBIT
TORBA<:.05:::;
RABBIT<:.05:::;

! Radiation

PRAD=PBRAD;

PE = PEBM+POH+PEECR-PRAD-PEICL; !+CAR42;
PI = PIBM+PEICL; !-CAR42;

SN=SNEBM;
SNN=SNNEU;
CAR11=CUBM;

! PFAST = PBLON*1/3+2/3*PBPER; in kev*1/m**3 10**19


!TGLF call
CF16 = 1.0;
tglf_ipc(CF16)<:0.02:::;

CAR17 = "tglf_out%chi_i(j)";
CAR18 = "tglf_out%chi_e(j)";
CAR20 = "tglf_out%e_pflux(j)";
CAR42 = "tglf_out%equipart(j)"; ! to be added to PE and subtracted to PI
CAR43 = "tglf_out%gamma(j)";
CAR44 = "tglf_out%omega(j)";

XI = min(20., max(0., CAR17)) + HNASI;
HE = min(20., max(0., CAR18)) + HNGSE;
DN = HNGSE;
CN = CAR20 -VP*VRAS;

DVN=CF14;
DVE=CF14;
DVI=CF14;

XE=0.0; 
HI=0.0;
CI=0.0;
DI=0.0;   
HN=0.0;
XN=0.0; 
DE=0.0; 

!Bootstrap coefficients
HC=HCSA;
DC=DCSA; 
XC=XCSA; 

!Plasma rotation
VPOL=VPSWW; !Poloidal rotation
VTOR=VTORX; !Toroidal rotation
ER=BTOR*(VDIA-VPOL)+BTOR*AMETR*MU*VTOR/RTOR;

!---------------------
! Transport equations

NE=NEX; 
NE:EQ[2,CF16];

TE=TEX;
TE:EQ[2,CF16];

TI=TIX;
TI:EQ[2,CF16];

CU:EQ; 

MU = 1./(CAR2X + 0.0001);
CC = CNHR; !CNSA;
