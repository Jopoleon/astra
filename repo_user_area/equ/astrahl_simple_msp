!===========================================================!
!== Simple use of STRAHL-ASTRA8 with new output structure ==!
!===========================================================!
!
! Daniel Fajardo (2023)
! run e.g. with exp/AUG33040_2500
!
!----------------- General parameters ----------------------!
NEQUIL = 91.;
MEQUIL = 90.;
IPEQL = 4;

! Time step definition
TAUMIN = 0.01;           ! minimum time step
TAUMAX = 0.01;           ! maximum time step

!------------------- Plasma species ------------------------!

! Main ion species
AMAIN=AMJ;     ! mass
ZMAIN=ZMJ;     ! charge

! Impurity 1
AIM1=10.;		 ! Boron mass
ZIM1="zavg_strahl(j,1)"; ! Boron charge, calculated by STRAHL
NIZ1="nimp_strahl(j,1)"; ! Boron density, evolved in time by STRAHL

! Impurity 2
AIM2=184.;		 ! Tungsten mass
ZIM2="zavg_strahl(j,2)"; ! Tungsten charge, calculated by STRAHL
NIZ2="nimp_strahl(j,2)"; ! Tungsten density, evolved in time by STRAHL


! Impurity 3
AIM3=40.;		 ! Argon mass
ZIM3="zavg_strahl(j,3)"; ! Argon charge, calculated by STRAHL
NIZ3="nimp_strahl(j,3)"; ! Argon density, evolved in time by STRAHL

! Deuterium density, from quasineutrality
NDEUT=NE-(ZIM1*NIZ1+ZIM2*NIZ2+ZIM3*NIZ3);
NMAIN=NDEUT;

! Thermal ion density
NI=NDEUT;
NIX=(NEX-ZIM1*NIZ1-ZIM2*NIZ2-ZIM3*NIZ3)+NIZ1+NIZ2+NIZ3;

! Effective charge (calculated by STRAHL)
ZEF=max(1.,"zeff_strahl(j)");
!ZEF=(NDEUT*ZMJ**2+NIZ1*ZIM1**2+NIZ2*ZIM2**2+NIZ3*ZIM3**2)/NE; ! to compare to STRAHL

!----------------------- Sources ---------------------------!

! Radiation (calculated by STRAHL)
PRAD="prad_tot_strahl(j)";

!--------------------- TRANSPORT ---------------------------!

! Impurity transport from simple analytical expressions

! impurity diffusion coefficient
CAR40 = 1.0;
! impurity convection
CAR41 = -5.0*FX;

! impurity 2 diffusion coefficient
CAR42 = 1.0;
! impurity 2 convection
CMHD1=1./3.;
CAR43 = -5.0*3.*FX*(1.-XSTEP(CMHD1)) - 5.0*(2.-3.*FX)*XSTEP(CMHD1);

! impurity 2 diffusion coefficient
CAR44 = 1.0;
! impurity 2 convection
CMHD2=1./3.;
CAR45 = 5.0*3.*FX*(1.-XSTEP(CMHD2)) + 5.0*(2.-3.*FX)*XSTEP(CMHD2);


!------------------ Transport equations --------------------!

! main species profiles are assigned

! electron density evolution
NE=NEX; ! initial condition: experimental profile
NE:AS;  ! assigned value


! electron temperature evolution
TE=TEX; ! initial condition: experimental profile
TE:AS;  ! assigned value

! main ion temperature evolution
TI=TIX; ! initial condition: experimental profile
TI:AS;  ! assigned value


! current diffusion equation
CU:AS;
!MU = MUX;  ! rotational transform (inverse safety factor)
MU = 1./(CAR2X + 1.e-4);

IPL=IPLX; ! total plasma current fixed from exp. value

!----------------!
!-CALL TO STRAHL-!
!----------------!

! inputs
! set for strahl_mod
"Dz_in_strahl(j,1) = CAR40(j)"; ! impurity 1 diffusion coefficient
"Vz_in_strahl(j,1) = CAR41(j)"; ! impurity 1 convective velocity
"Dz_in_strahl(j,2) = CAR42(j)"; ! impurity 2 diffusion coefficient
"Vz_in_strahl(j,2) = CAR43(j)"; ! impurity 2 convective velocity
"Dz_in_strahl(j,3) = CAR44(j)"; ! impurity 3 diffusion coefficient
"Vz_in_strahl(j,3) = CAR45(j)"; ! impurity 3 convective velocity

CPEL1 = CIMP1*1.e19; ! edge source of impurities in atoms/second
      		     ! CIMP1 used to increase or decrease this source term. Default for B:  CIMP1 = 2.e1 in log.
CPEL2 = CIMP2*1.e19; ! edge source of impurities in atoms/second
      		     ! CIMP2 used to increase or decrease this source term. Default for W:  CIMP1 = 5.e-1 in log.
CPEL3 = CIMP3*1.e19; ! edge source of impurities in atoms/second
      		     ! CIMP3 used to increase or decrease this source term. Default for Ar: CIMP1 = 5.e0 in log.

"rrates_in_strahl(1) = CPEL1";
"rrates_in_strahl(2) = CPEL2";
"rrates_in_strahl(3) = CPEL3";

! to sbr call:
CSOL1 = 1.d0*CSOL2; ! SOL diffusivity for impurities in STRAHL in m^2/s (control from log with CSOL2, default: 1.0)

A2STRAHL(0.d0, 1.d6, 1.d6, CSOL1, 0.d0)>::::;

! take outputs from A2STRAHL

CAR51 = "prad_main_strahl(j)"; ! Bremsstrahlung
CAR52 = "nmain_strahl(j)";     ! main ion density
CAR53 = "prad_strahl(j,1)";    ! radiation of impurity 1
CAR54 = "prad_strahl(j,2)";    ! radiation of impurity 2
CAR55 = "prad_strahl(j,3)";    ! radiation of impurity 3

! compare STRAHL calculations to ASTRA approximate formulas
CAR56 = PBRAD+NE*(PRWOL*NIZ1+PRARG*NIZ3);
CAR57 = ZIWOL;
CAR58 = ZIAR;

! Compare impurity density evolution with ASTRA

SF1 = 0.0;
SFF1 = 0.0;
DF1 = CAR40;
VF1 = CAR41;

F1 = NIZ1;	     ! initial condition
F1:EQ[2,1.0]; 	     ! evolution equation 
F1B=NIZ1(AFX(1.0)); ! boundary condition

SF2 = 0.0;
SFF2 = 0.0;
DF2 = CAR42;
VF2 = CAR43;

F2 = NIZ2;	     ! initial condition
F2:EQ[2,1.0]; 	     ! evolution equation 
F2B=NIZ2(AFX(1.0));  ! boundary condition

SF3 = 0.0;
SFF3 = 0.0;
DF3 = CAR44;
VF3 = CAR45;

F3 = NIZ3;	     ! initial condition
F3:EQ[2,1.0]; 	     ! evolution equation 
F3B=NIZ3(AFX(1.0));  ! boundary condition

!----------------- plotting radial profiles ------------------!

! Page 1: main profiles, radiation and Zeff

! top panel, red
Te\TE\\TEX\-10;		Nz1S\NIZ1\-1;	Nz2S\NIZ2\-2;	Nz3S\NIZ3\-3;
! lower panel, red
Ne\NE\\NEX\-11;		Dz1\CAR40\3.;	Dz2\CAR42\3.;	Dz3\CAR44\3.;

! top panel, blue
Ti\TI\\TIX\-10;		Nz1A\F1\-1;		Nz2A\F2\-2;	Nz3A\F3\-3;
!lower panel, blue
NiS\CAR52\-11;	Vz1\CAR41+5.\10.;	Vz2\CAR43+5.\10.;  Vz3\CAR45+5.\10.;

! Page 2: Radiated powers, and charges Zeff
! top panel, red
PraS\PRAD\-7;	Prad\PRAD\-7;	Prad\PRAD\-7;	Prad\PRAD\-7;
! lower panel, red
ZefS\ZEF\-8;	PbrS\CAR51\-9;	Z1S\ZIM1\6.;	Z3S\ZIM3\18.;

! top panel, blue
PraA\CAR56;	Pr1\CAR53\-7;	Pr2\CAR54\-7;	Pr3\CAR55\-7;
!lower panel, blue
\;	PbrA\PBRAD\-9;	Z2S\ZIM2;	\;


!----------------- plotting time traces ------------------!

!TSCALE = 20.;

Sr1_CIMP1; Sr2_CIMP2; Sr3_CIMP3;
Prad_VINT(PRADB); Zefl_LININT(ZEFB)/(2.*ABC);  nBl_LININT(NIZ1B)/(2.*ABC);
nWl_LININT(NIZ2B)/(2.*ABC);  nArl_LININT(NIZ3B)/(2.*ABC);
PrB_VINT(CAR53B); PrW_VINT(CAR54B); PrAr_VINT(CAR55B); Pbre_VINT(CAR51B);
Dsol_CSOL1;
