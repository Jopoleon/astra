!===========================================================!
!== Simple use of STRAHL-ASTRA8 with new output structure ==!
!===========================================================!
!
! Daniel Fajardo (2023)
! run e.g. with exp/AUG33040_2500
!
!----------------- General parameters ----------------------!

! Time step definition
TAUMIN = 0.025;           ! minimum time step
TAUMAX = 0.025;           ! maximum time step

!------------------- Plasma species ------------------------!

! Main ion species
AMAIN=AMJ;         ! mass
ZMAIN=ZMJ;         ! charge

! Main impurity of interest
AIM1=184.;     ! W mass
ZIM1=CAR45;    ! Tungsten charge, calculated by STRAHL
	       ! CAR45 will be used in the call to A2STRAHL

NIZ1=1.*CAR40; ! Tungsten density, evolved in time by STRAHL
	       ! CAR40 will be used in the call to A2STRAHL

! Deuterium density, from quasineutrality
NDEUT=NE-(ZIM1*NIZ1);
NMAIN=NDEUT;

! Thermal ion density
NI=NDEUT;
NIX=(NEX-NIZ1*ZIM1)+NIZ1;

! Effective charge (calculated by STRAHL)
!ZEF=CAR41+1.e-8; ! CAR41 will be used in the call to A2STRAHL
ZEF=(NDEUT*ZMJ**2+NIZ1*ZIM1**2)/NE; ! to compare to STRAHL

!----------------------- Sources ---------------------------!

! Radiation (calculated by STRAHL)
PRAD=CAR42; ! CAR42 will be used in the call to A2STRAHL

!--------------------- TRANSPORT ---------------------------!

! Impurity transport from simple analytical expressions

! impurity diffusion coefficient
CAR43 = CIMP2;    ! CIMP2 is controllable from log.
      	          ! Default: CIMP2 = 1.0
	          ! --> constant diff. coeff. of 1m^2/s 
! impurity convection
CAR44 = CIMP3*FX; ! CIMP3 is controllable from log.
      		  ! Default: CIMP3 = -5.0
		  ! --> linearly increasing inward convection 


!------------------ Transport equations --------------------!

! main species profiles are assigned

! electron density evolution
NE=NEX; ! initial condition: experimental profile
NE:AS;  ! assigned value


! electron temperature evolution
TE=TEX; ! initial condition: experimental profile
TE:AS;  ! assigned value

! main ion temperature evolution
TI=TIX; ! initial condition: experimental profile
TI:AS;  ! assigned value


! current diffusion equation
CU:AS;
!MU = MUX;  ! rotational transform (inverse safety factor)
MU = 1./(CAR2X + 1.e-4);

IPL=IPLX; ! total plasma current fixed from exp. value

!----------------!
!-CALL TO STRAHL-!
!----------------!
! arguments are:
! - (I) time at which STRAHL starts
! - (I) time at which NEOART starts inside STRAHL. Set to high number so we don't run NEOART.
! - (I) time step of NEOART
! - (I) impurity SOL diffusivity
! - (I) impurity "anomalous" diffusion coefficient (actually we give turb + coll here because we're not using NEOART)
! - (I) impurity "anomalous" convection coefficient (" ")
! - (O) impurity charge (radial array)
! - (I) impurity mass
! - (O) impurity density
! - (O) effective charge
! - (O) neoclassical diff. coeff. calculated by NEOART
! - (O) neoclassical conv. coeff. calculated by NEOART
! - (I) edge source of impurities (e.g. puff rate of impurity in atoms/second entering the LCFS) -> CPEL1 in this case
! - (I) factor of puff rate (?)
! - (I) factor of puff rate (?)
! - (I) shot number (?)

CPEL1 = CIMP4*1.e19; ! edge source of impurities in atoms/second
      		     ! CIMP4 used to increase or decrease this source term. Default for W: CIMP4 = 5.e-2 in log.

A2STRAHL(TAU,TAU+1.e6,TAU,1.d0,CAR43,CAR44,CAR45,AIM1,CAR40,CAR41,CAR60,CAR61,CPEL1,1.,1.,0.)>::::;

! take additional outputs of A2STRAHL
! (see names in sbr/a2strahl.f90 and mod/strahl_mod.f90)
CAR42 = "prad_tot(j)"; ! radiated power

! other radiated power expressions to compare
CAR51 = PBRAD; 	       ! Bremsstrahlung formula of ASTRA
CAR52 = PRWOL*NE*NIZ1; ! Tungsten radiation power formula of ASTRA

! Compare impurity density evolution with ASTRA

SF1 = 0.0;
SFF1 = 0.0;
DF1 = CAR43;
VF1 = CAR44;

F1 = CAR40;	     ! initial condition
F1:EQ[2,0.99]; 	     ! evolution equation 
FIB=CAR40(AFX(0.99)); ! boundary condition

!------------------ write profile output --------------------!

! NetCDF output
!A2CDF>:0.1:::;

!----------------- plotting radial profiles ------------------!


! Page 1: main profiles and transport

! top panel, red
Te\TE\\TEX\-3;	Ne\NE\\NEX;	NzS\CAR40\-2;		ZwS\CAR45\-4;
! lower panel, red
PraS\CAR42\-5; 	Pbre\CAR51\-5;	DzW\CAR43\;		ZefS\CAR41\-1;

! top panel, blue
Ti\TI\\TIX\-3;	Ni\NI;		NzA\F1\-2;		ZwA\ZIWOL\-4;
!lower panel, blue
PraA\CAR52\-5; 	Qf1\QF1+0.01\0.02;	VzW\CAR44+5.\10.;	ZefA\ZEF\-1;
