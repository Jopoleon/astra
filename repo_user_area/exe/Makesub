ifndef AWD
$(error setenv/export AWD first)
endif

SRC_DIR = $(AWD)/$(sub)
OBJ_DIR = $(AWD)/obj/$(sub)
MOD_DIR = $(AWD)/mod/$(sub)
INC_DIR = $(AWD)/inc
MOD_FOR = $(AWD)/mod/for 
MOD_FEQ = $(AWD)/mod/feqis 
LIB_DIR = $(AWD)/lib
LIB = $(LIB_DIR)/lib$(sub).a

FC_FLAGS = -r8 -no-prec-div -traceback -ip -O0 -w -fPIC -qopenmp $(CHECKALLCOMP)

SRCF90 := $(wildcard $(SRC_DIR)/*.f90)
SRCF   := $(wildcard $(SRC_DIR)/*.f)
SRCC   := $(wildcard $(SRC_DIR)/*.c)

OBJF90 := $(patsubst $(SRC_DIR)%.f90, $(OBJ_DIR)%.o, $(SRCF90))
OBJF   := $(patsubst $(SRC_DIR)%.f, $(OBJ_DIR)%.o, $(SRCF)  )
OBJC   := $(patsubst $(SRC_DIR)%.c, $(OBJ_DIR)%.o, $(SRCC)  )

# Make Commands
.PHONY: all
all: directories $(LIB) mvmod

.PHONY: directories
directories:
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(MOD_DIR)
	@mkdir -p $(LIB_DIR)

.PHONY: mvmod
mvmod:
	rm -f *genmod.*
	-@mv *.mod $(MOD_DIR)/ 2>/dev/null; true

.PHONY: clean
clean:
	rm -rf $(OBJ_DIR)
	rm $(LIB)

$(OBJ_DIR)%.o: $(SRC_DIR)%.f
	$(FC) $(FC_FLAGS) -I$(MOD_FOR) -c $< -o $@

$(OBJ_DIR)/tglf_serial.o: $(SRC_DIR)/tglf_serial.f90 $(TGLF_LIB)
	$(FC) $(FC_FLAGS) -I$(MOD_FOR) -I$(TGLF_INC) -c $< -o $@

$(OBJ_DIR)/qlknn_serial.o: $(SRC_DIR)/qlknn_serial.f90 $(QLKNN_LIB)
	$(FC) $(FC_FLAGS) -I$(MOD_FOR) -I$(QLKNN_INC) -c $< -o $@

$(OBJ_DIR)/rabbit.o: $(SRC_DIR)/rabbit.f90
	$(FC) $(FC_FLAGS) -I$(MOD_FOR) -I$(RABBIT_INC) -c $< -o $@

$(OBJ_DIR)%.o: $(SRC_DIR)%.f90
	$(FC) $(FC_FLAGS) -I$(MOD_FOR) -I$(MOD_FEQ) -c $< -o $@

$(OBJ_DIR)%.o: $(SRC_DIR)%.c
	$(CC) -I$(INC_DIR) -c $< -o $@

$(LIB): $(OBJF90) $(OBJF) $(OBJC)
	ar rv $(LIB) $(OBJF90) >/dev/null
	ar rv $(LIB) $(OBJF) >/dev/null
	ar rv $(LIB) $(OBJC) >/dev/null
	ranlib $(LIB)
