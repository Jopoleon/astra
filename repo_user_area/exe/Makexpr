ifndef AWD
$(error setenv/export AWD first)
endif

XPR = $(AWD)/xpr
INC_DIR = $(AWD)/inc
MOD_ASTRA = $(AWD)/mod/astra
LIBASTRA = $(AWD)/lib/libastra.a
AENV = $(AWD)/exe/astra_rc

ifeq ($(FC),gfortran)
  ADD_LIBS :=
  LD := $(FC)
  OMP_FFLAG =-fopenmp
  OMP_CFLAG =-fopenmp
  LD_MPI := $(MPIFC) $(OMP_FFLAG)
  MPI_FC = $(MPIFC) $(OMP_FFLAG)
else
  ADD_LIBS := -L$(COMP_LIBDIR) -lifcoremt -lifport -lifcore
  LD := $(CC)
  OMP_CFLAG =-qopenmp
  LD_MPI := $(MPICC) $(OMP_CFLAG)
  MPI_FC = $(MPIFC) $(OMP_FFLAG)
endif

# TGLF

MKL_LIB = -Wl,--start-group $(MKL_LIBDIR)/libmkl_intel_lp64.a $(MKL_LIBDIR)/libmkl_core.a $(MKL_LIBDIR)/libmkl_sequential.a -Wl,--end-group

#-----

.PHONY: all
all: directories $(XPR)/tglfi $(XPR)/qlki $(XPR)/neo

.PHONY: directories
directories:
	@mkdir -p $(AWD)/tglf
	@mkdir -p $(AWD)/qualikiz
	@mkdir -p $(AWD)/neo

.PHONY: clean
clean:
	rm -f $(XPR)/*.o
	rm -f $(XPR)/tglfi
	rm -f $(XPR)/qlki
	rm -f $(XPR)/neo


$(XPR)/tglfi:	$(XPR)/tglfinter.o $(XPR)/tglf_interf.o $(LIBASTRA) $(TGLF_LIB) $(AENV)
	$(LD) -o $@ $(XPR)/tglfinter.o $(XPR)/tglf_interf.o $(LIBASTRA)	\
	$(TGLF_LIB) $(MKL_LIB) -lpthread -lm $(ADD_LIBS)

$(XPR)/neo:	$(XPR)/neointer.o $(XPR)/neo_interf.o $(LIBASTRA) $(NEO_LIB) $(AENV)
	$(LD_MPI) -o $@ $(XPR)/neointer.o $(XPR)/neo_interf.o $(LIBASTRA)	\
	$(NEO_LIB) $(MKL_LIB) -lpthread -lm $(ADD_LIBS)

$(XPR)/qlki:	$(XPR)/qlkinter.o $(XPR)/qlk_interf.o $(LIBASTRA) $(QLK_LIB) $(AENV)
	$(LD_MPI) -o $@ $(XPR)/qlkinter.o $(XPR)/qlk_interf.o $(LIBASTRA)	\
	$(QLK_LIB) $(MKL_LIB) -lpthread -lm $(ADD_LIBS)

# c wrapper

$(XPR)/tglfinter.o:   $(XPR)/tra_interf.c
	$(CC) -I$(INC_DIR) -o $@ -c $< -Dtglf

$(XPR)/neointer.o:    $(XPR)/tra_interf.c
	$(CC) -I$(INC_DIR) -o $@ -c $< -Dneo

$(XPR)/qlkinter.o:    $(XPR)/tra_interf.c
	$(CC) -I$(INC_DIR) -o $@ -c $< -Dqlk

# Fortran

$(XPR)/tglf_interf.o:    $(XPR)/tglf_interf.f90
	$(FC) -I$(TGLF_INC) -o $@ -c $<

$(XPR)/neo_interf.o:    $(XPR)/neo_interf.f90
	$(MPI_FC) -I$(NEO_INC) -o $@ -c $<

$(XPR)/qlk_interf.o:    $(XPR)/qlk_interf.f90
	$(MPI_FC) -I$(QLK_INC) -o $@ -c $<
