ifndef AWD
$(error setenv/export AWD first)
endif

XPR = $(AWD)/xpr
INC_DIR = $(AWD)/inc
MOD_FOR = $(AWD)/mod/for
LIBFOR = $(AWD)/lib/libfor.a
AENV = $(AWD)/exe/astra_rc

# TGLF

MKL_LIB = -Wl,--start-group $(MKL_LIBDIR)/libmkl_intel_lp64.a $(MKL_LIBDIR)/libmkl_core.a $(MKL_LIBDIR)/libmkl_sequential.a -Wl,--end-group
#-----

# Qualikiz
MPI_FC = $(MPIFC) -qopenmp -r8 -no-prec-div -traceback
MPI_CC = mpiicx -qopenmp

#-----

.PHONY: all
all: directories $(XPR)/tglfi $(XPR)/qlki $(XPR)/neo

.PHONY: directories
directories:
	@mkdir -p $(AWD)/tglf
	@mkdir -p $(AWD)/qualikiz

.PHONY: clean
clean:
	rm -f $(XPR)/*.o
	rm -f $(XPR)/tglfi
	rm -f $(XPR)/qlki
	rm -f $(XPR)/neo


$(XPR)/tglfi:	$(XPR)/tglfinter.o $(XPR)/tglf_interf.o $(XPR)/qinterp.o $(LIBFOR) $(TGLF_LIB) $(AENV)
	icx -o $@ $(XPR)/tglfinter.o $(XPR)/tglf_interf.o $(XPR)/qinterp.o $(LIBFOR)	\
	$(TGLF_LIB) $(MKL_LIB) -lpthread -lm -L$(COMP_LIBDIR) -lifcoremt -lifport -lifcore

$(XPR)/neo:	$(XPR)/neointer.o $(XPR)/neo_interf.o $(XPR)/qinterp.o $(LIBFOR) $(NEO_LIB) $(AENV)
	$(MPI_CC) -o $@ $(XPR)/neointer.o $(XPR)/neo_interf.o $(XPR)/qinterp.o $(LIBFOR)	\
	$(NEO_LIB) $(MKL_LIB) -lpthread -lm -L$(COMP_LIBDIR) -lifcoremt -lifport -lifcore

$(XPR)/qlki:	$(XPR)/qlkinter.o $(XPR)/qlk_interf.o $(XPR)/qinterp.o $(LIBFOR) $(QLK_LIB) $(AENV)
	$(MPI_CC) -o $@ $(XPR)/qlkinter.o $(XPR)/qlk_interf.o $(XPR)/qinterp.o $(LIBFOR)	\
	$(QLK_LIB) $(MKL_LIB) -lpthread -lm -L$(COMP_LIBDIR) -lifcoremt -lifport -lifcore

# c wrapper

$(XPR)/tglfinter.o:   $(XPR)/tra_interf.c
	$(CC) -I$(INC_DIR) -o $@ -c $< -Dtglf

$(XPR)/neointer.o:    $(XPR)/tra_interf.c
	$(CC) -I$(INC_DIR) -o $@ -c $< -Dneo

$(XPR)/qlkinter.o:    $(XPR)/tra_interf.c
	$(CC) -I$(INC_DIR) -o $@ -c $< -Dqlk

# Fortran

$(XPR)/qinterp.o:    $(XPR)/qinterp.f90
	$(FC) -o $@ -c $< -Dneo

$(XPR)/tglf_interf.o:    $(XPR)/tglf_interf.f90
	$(FC) -I$(TGLF_INC) -o $@ -c $<

$(XPR)/neo_interf.o:    $(XPR)/neo_interf.f90
	$(MPI_FC) -I$(NEO_INC) -o $@ -c $<

$(XPR)/qlk_interf.o:    $(XPR)/qlk_interf.f90
	$(MPI_FC) -I$(QLK_INC) -o $@ -c $<
