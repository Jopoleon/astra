XPR = $(AWD)/xpr
INC_DIR = $(AWD)/inc
MOD_DIR = $(AWD)/mod/for
LIB_DIR = $(AWD)/lib
LIBIPC = $(LIB_DIR)/libipc.a
AENV = $(AWD)/exe/astra_rc

# TGLF

ACC = cc
MKL_LIB = -Wl,--start-group $(MKL_LIBDIR)/libmkl_intel_lp64.a $(MKL_LIBDIR)/libmkl_core.a $(MKL_LIBDIR)/libmkl_sequential.a -Wl,--end-group
#-----

# Qualikiz
MPI_FC = $(MPIFC) -qopenmp -r8 -no-prec-div -ip -g
#-----

.PHONY: all
all: directories $(XPR)/tglfi $(XPR)/qlki $(XPR)/neo

.PHONY: directories
directories:
	@mkdir -p $(LIB_DIR)
	@mkdir -p $(AWD)/tglf
	@mkdir -p $(AWD)/qualikiz

.PHONY: clean
clean:
	rm -f $(XPR)/*.o
	rm -f $(XPR)/tglfi
	rm -f $(XPR)/qlki
	rm -f $(XPR)/neo


$(XPR)/tglfi:	$(XPR)/tglf_interf.f90 $(XPR)/qinterp.f90 $(LIBIPC) $(AENV)
		$(AFC) -o $@ $(XPR)/tglf_interf.f90 $(XPR)/qinterp.f90 $(XPR)/tglfinter.o $(LIBIPC)	\
		-I$(TGLF_INC) $(TGLF_LIB) $(MKL_LIB) -lpthread -lm

$(XPR)/neo:	$(XPR)/neo_interf.f90 $(XPR)/qinterp.f90 $(LIBIPC) $(AENV)
		$(MPI_FC) -o $@ $(XPR)/neo_interf.f90 $(XPR)/qinterp.f90 $(LIBIPC)	\
		-I$(NEO_INC) $(NEO_LIB) $(MKL_LIB) -lpthread -lm

$(XPR)/qlki:	$(XPR)/qlk_interf.f90 $(XPR)/qinterp.f90 $(LIBIPC) $(AENV)
		$(MPI_FC) -o $@ $(XPR)/qlk_interf.f90 $(XPR)/qinterp.f90 $(XPR)/qlkinter.o $(LIBIPC)	\
		-I$(QLK_INC) $(QLK_LIB)

$(LIBIPC): $(AWD)/ipc/*
	make -f $(AWD)/exe/Makeipc
