ifndef AWD
$(error setenv/export AWD first)
endif

XPR = $(AWD)/xpr
INC_DIR = $(AWD)/inc
LIBFOR = $(AWD)/lib/libfor.a
AENV = $(AWD)/exe/astra_rc
ACC=cc

# TGLF

MKL_LIB = -Wl,--start-group $(MKL_LIBDIR)/libmkl_intel_lp64.a $(MKL_LIBDIR)/libmkl_core.a $(MKL_LIBDIR)/libmkl_sequential.a -Wl,--end-group
#-----

# Qualikiz
MPI_FC = $(MPIFC) -qopenmp -r8 -no-prec-div -ip -g
#-----

.PHONY: all
all: directories $(XPR)/tglfi $(XPR)/qlki $(XPR)/neo

.PHONY: directories
directories:
	@mkdir -p $(AWD)/tglf
	@mkdir -p $(AWD)/qualikiz

.PHONY: clean
clean:
	rm -f $(XPR)/*.o
	rm -f $(XPR)/tglfi
	rm -f $(XPR)/qlki
	rm -f $(XPR)/neo


$(XPR)/tglfi:	$(XPR)/tglf_interf.f90 $(XPR)/qinterp.f90 $(XPR)/tglfinter.o $(LIBFOR) $(AENV)
		$(FC) -o $@ $(XPR)/tglf_interf.f90 $(XPR)/qinterp.f90 $(XPR)/tglfinter.o $(LIBFOR)	\
		-I$(TGLF_INC) $(TGLF_LIB) $(MKL_LIB) -lpthread -lm

$(XPR)/neo:	$(XPR)/neo_interf.f90 $(XPR)/qinterp.f90 $(XPR)/neointer.o $(LIBFOR) $(AENV)
		$(MPI_FC) -o $@ $(XPR)/neo_interf.f90 $(XPR)/qinterp.f90 $(XPR)/neointer.o $(LIBFOR)	\
		-I$(NEO_INC) $(NEO_LIB) $(MKL_LIB) -lpthread -lm

$(XPR)/qlki:	$(XPR)/qlk_interf.f90 $(XPR)/qinterp.f90 $(XPR)/qlkinter.o $(LIBFOR) $(AENV)
		$(MPI_FC) -o $@ $(XPR)/qlk_interf.f90 $(XPR)/qinterp.f90 $(XPR)/qlkinter.o $(LIBFOR)	\
		-I$(QLK_INC) $(QLK_LIB)

$(XPR)/neointer.o:    $(XPR)/tra_interf.c
		$(ACC) -I$(INC_DIR) -o $@ -c $< -Dneo

$(XPR)/tglfinter.o:   $(XPR)/tra_interf.c
		$(ACC) -I$(INC_DIR) -o $@ -c $< -Dtglf

$(XPR)/qlkinter.o:    $(XPR)/tra_interf.c
		$(ACC) -I$(INC_DIR) -o $@ -c $< -Dqlk
