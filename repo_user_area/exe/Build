#!/bin/bash -f

source /etc/profile.d/modules.sh

if [[ $# > 0 ]]; then
    WAIT_SLURM=$1
else
    WAIT_SLURM=""
fi

rootdir=`dirname $0`                  # may be relative path
export AWD=`cd $rootdir/.. && pwd`    # ensure absolute path

cd $AWD

platform=`$AWD/get_platform`

# Get variables from log file

ALOG=$AWD/tmp/astra.nml
while IFS='=' read var val
do
    var=`echo $var | xargs` #xargs for trimming
    val=`echo $val | xargs`
    if [[ $val ]]
    then
        declare "$var=$val"
    fi
done < $ALOG

if [[ $platform == "mit" ]]
then
    NETCDF_LIBDIR=${NETCDF_C_ROOT}/lib
    NETCDFF_LIBDIR=${NETCDF_FORTRAN_ROOT}/lib
    export COMP_LIBDIR=${INTEL_ONEAPI_MKL_ROOT}/compiler/2023.1.0/linux/compiler/lib/intel64_lin
    export MKL_LIBDIR=${MKLROOT}/lib/intel64
    export NETCDF_LIB="-L${NETCDF_LIBDIR} -lnetcdf -L${NETCDFF_LIBDIR} -lnetcdff -Wl,-rpath,${NETCDF_LIBDIR}:${NETCDFF_LIBDIR}"
    export NETCDF_INC=${NETCDF_FORTRAN_ROOT}/include
fi

source $AWD/exe/astra_rc

export expfile="${exp_file}"
export equfile="${equ_file}"

echo Compile main ASTRA executable $equ_file $AWD 
make -f exe/Makefile MODEL=$equ_file
status=$?
if [ $status -ne 0 ]
then
    echo Error from exe/Makefile-compilation, exiting
    exit 1
fi

echo Compile IPC programs
make -f exe/Makexpr
status=$?
if [ $status -ne 0 ]
then
    echo Error from exe/Makexpr-compilation, exiting
    exit 2
fi

exe/CheckObjs
status=$?
if [ $status -ne 0 ]
then
    echo CheckObjs failed: conflicting object names
    exit 3
fi

# Execution

ATASK=$AWD/bin/$equ_file.exe

if [ "$TASK" == 'BGD' ]
then
    if ! command -v sbatch &> /dev/null
    then
        echo Running $ATASK without graphic interactive window
        $ATASK
    else
        bat="$AWD/exe/batch.sh"
        cat << EOT > $bat
#!/bin/sh
#SBATCH -J astra_${USER}
#SBATCH --partition=p.tok.openmp
#SBATCH --qos=p.tok.openmp.48h
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem-per-cpu 1GB
#SBATCH --time=12:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user ${USER}@ipp.mpg.de
export OMP_NUM_THREADS=\${SLURM_CPUS_PER_TASK:-1}
export expfile=${expfile}
export equfile=${equfile}
export OMP_PLACES=cores
export AEXT=${AEXT}
export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}
srun $ATASK
EOT

        echo sbatch $bat
        date
        module unload impi-interactive
#        sbatch -W $bat # -W: waiting for process to finish before running nc_concat
        sbatch $WAIT_SLURM $bat
    fi
else
    echo Running $ATASK
    $ATASK
    echo ASTRA normal exit
    echo
    for mod_name in tglfi qlkzi qlki neo
    do
        PID=$(ps aux | grep $mod_name | grep 'R+' | awk '{print $2}')
        if [ ! -z "$PID" ];
        then
            for p_id in $PID
            do
                kill -9 $p_id
            done
        fi
    done
fi
