#!/bin/bash -f

source /etc/profile.d/modules.sh

if [[ $# > 0 ]]; then
    WAIT_SLURM=$1
else
    WAIT_SLURM=""
fi

rootdir=`dirname $0`                  # may be relative path
export AWD=`cd $rootdir/.. && pwd`    # ensure absolute path

cd $AWD

platform=`$AWD/get_platform`

# Get variables from log file

ALOG=$AWD/tmp/astra.nml
while IFS='=' read var val
do
    var=`echo $var | xargs` #xargs for trimming
    val=`echo $val | xargs`
    if [[ $val ]]
    then
        declare "$var=$val"
    fi
done < $ALOG

if [[ $platform = "docker" ]]
then
   # Same as "module load astra" on AUG machines
   export ASTRA_EXT=/shares/departments/AUG/users/git/ASTRA_LIBRARIES_EXT

   # Corresponds to the default installation of the Fenix Docker
   export MKL_LIBDIR=/opt/intel/oneapi/mkl/latest/lib/intel64
   export COMP_LIBDIR=/opt/intel/oneapi/compiler/latest/linux/compiler/lib/intel64_lin
   export AFC=ifort
   export ACC="gcc -O"
   export MPIFC=mpiifort
   export IFORT_BIN=/opt/intel/oneapi/compiler/latest/linux/bin/intel64
   export INTEL_LICENSE_FILE=/opt/intel/oneapi/mkl/latest/licencing
elif [[ $platform = "ncku" ]]
then
    # /compiler/2024.1/bin/compiler
    PKG=/opt/intel/oneapi
    export MKL_LIBDIR=${PKG}/mkl/lib/intel64_lin
    export COMP_LIBDIR=${PKG}/compiler/2024.1/lib
    export I_MPI_ROOT=${PKG}/mpi/2021.12
    export IFORT_BIN=${PKG}/compiler/2024.1/bin
    export MPIFORT_BIN=${I_MPI_ROOT}/bin
    export AFC=ifort
    export ACC="cc -O"
    export MPIFC=mpiifort
    export ASTRA_EXT=/home/astrainstaller/ASTRA_LIBRARIES_EXT
# MPI
    export MPI_INC="-I${I_MPI_ROOT}/include"
    export MPI_LIB="-L${I_MPI_ROOT}/lib -lmpigf -lmpi"
fi

source $AWD/exe/astra_rc

export expfile="${exp_file}"
export equfile="${equ_file}"

export CHECKALLCOMP=" "
#export CHECKALLCOMP="-check all -traceback"

echo Compile main ASTRA executable $equ_file $AWD 
make -f exe/Makefile MODEL=$equ_file WORKFLOW=$AWD/main/stepup.f90
status=$?
if [ $status -ne 0 ]
then
    echo Error from exe/Makefile-compilation, exiting
    exit 1
fi

echo Compile IPC programs
make -f exe/Makexpr
status=$?
if [ $status -ne 0 ]
then
    echo Error from exe/Makexpr-compilation, exiting
    exit 2
fi

exe/CheckObjs
status=$?
if [ $status -ne 0 ]
then
    echo CheckObjs failed: conflicting object names
    exit 3
fi

# Execution

ATASK=$AWD/bin/$equ_file.exe

if [ "$TASK" = 'BGD' ]
then
    if ! command -v sbatch &> /dev/null
    then
        echo Running $ATASK without graphic interactive window
        $ATASK
    else
        bat="$AWD/exe/batch.sh"
        cat << EOT > $bat
#!/bin/sh
#SBATCH -J astra_${USER}
#SBATCH --partition=p.tok.openmp
#SBATCH --qos=p.tok.openmp.48h
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --mem-per-cpu 1GB
#SBATCH --time=12:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user ${USER}@ipp.mpg.de
export OMP_NUM_THREADS=\${SLURM_CPUS_PER_TASK:-1}
export expfile=${expfile}
export equfile=${equfile}
export OMP_PLACES=cores
export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}
export ASTRA_EXT=${ASTRA_EXT}
source /etc/profile.d/modules.sh
module purge
module load astra
srun $ATASK
EOT

        echo sbatch $bat
        date
        module unload impi-interactive
#        sbatch -W $bat # -W: waiting for process to finish before running json2cdf 
        sbatch $WAIT_SLURM $bat
    fi
else
    echo Running $ATASK
    $ATASK
    echo ASTRA normal exit
    echo
    for mod_name in tglfi qlkzi qlki neo
    do
        PID=$(ps aux | grep $mod_name | grep 'R+' | awk '{print $2}')
        if [ ! -z "$PID" ];
        then
            for p_id in $PID
            do
                kill -9 $p_id
            done
        fi
    done
fi
