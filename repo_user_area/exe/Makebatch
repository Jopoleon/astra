ifndef AWD
$(error setenv/export AWD first)
endif

LIB_DIR = $(AWD)/lib
TSK_DIR = $(AWD)/bin
ASTRA_DIR = $(AWD)/src/astra
MOD_DIR = $(AWD)/mod
OBJ_DIR = $(AWD)/obj
TMP_DIR = $(AWD)/src/tmp
XPR_DIR = $(AWD)/xpr
NBI_INC = $(AWD)/mod/nbi
EQU = $(AWD)/equ/$(MODEL)
EXP = $(AWD)/exp/$(FEXP)
LIBSBR   = $(LIB_DIR)/libsbr.a
LIBFNC   = $(LIB_DIR)/libfnc.a
LIBASTRA = $(LIB_DIR)/libastra.a
LIBMISC  = $(LIB_DIR)/libmisc.a
LIBNBI   = $(LIB_DIR)/libnbi.a
LIBFEQIS = $(LIB_DIR)/libfeqis.a

FC_FLAGS += -I$(AWD)
LD_FLAGS += -I$(AWD)

MKL_LIB = -Wl,--start-group $(MKL_LIBDIR)/libmkl_intel_lp64.a $(MKL_LIBDIR)/libmkl_core.a $(MKL_LIBDIR)/libmkl_sequential.a -Wl,--end-group
LIB = -lsbr -lnbi -L/usr/lib64 $(QLKNN_LIB) $(TGLF_LIB) $(TORB_LIB) $(RABBIT_LIB) $(SPIDER_LIB) -lastra -lfnc -lfeqis -lmisc $(JSON_LIB) -L$(LIB_DIR) $(MKL_LIB) -lrt

AENV = $(AWD)/exe/astra_rc

ASTRA_SRC = \
$(ASTRA_DIR)/astra_main.F90 $(ASTRA_DIR)/stepup.F90 

TMP_SRC = \
$(TMP_DIR)/associate_pointers.f90 \
$(TMP_DIR)/inivar.f90 \
$(TMP_DIR)/detvar.f90 \
$(TMP_DIR)/postep.f90 \
$(TMP_DIR)/ininam.f90 \
$(TMP_DIR)/init_converge_step.f90 \
$(TMP_DIR)/eqns_inc.f90

PY_TMP_GEN = $(AWD)/pyparse/parser_main.py -equ $(EQU) -exp $(EXP)

FMLS    := $(wildcard $(AWD)/fml/*)
PYFILES := $(wildcard $(AWD)/pyparse/*.py)

# Make Commands
.PHONY: all
all: directories modules $(ATASK)

.PHONY: directories
directories:
	@mkdir -p $(TSK_DIR)
	@mkdir -p $(TMP_DIR)
	@mkdir -p $(LIB_DIR)
	@mkdir -p $(AWD)/ncdf_out
	@mkdir -p $(AWD)/dat

.PHONY: clean
clean:
	rm -f *.mod
	make -f $(AWD)/exe/Makexpr clean
	rm -rf $(MOD_DIR)
	rm -rf $(TSK_DIR)
	rm -rf $(OBJ_DIR)
	rm -rf $(LIB_DIR)

.PHONY: modules
modules:
	make -f $(AWD)/exe/Makemisc modules
	make -f $(AWD)/exe/Makeastra modules
	make -f $(AWD)/exe/Makefeqis modules

# Linking, create ASTRA executable

$(ATASK): $(LIBASTRA) $(LIBMISC) $(LIBNBI) $(LIBFEQIS) $(SPIDER_LIB) $(LIBSBR) $(LIBFNC) $(AENV) $(EQU) $(ASTRA_SRC) $(PYFILES) $(FMLS)
	$(PY_TMP_GEN)
	$(FC) $(LD_FLAGS) -o $(ATASK) $(ASTRA_SRC) $(TMP_SRC) -I$(MOD_DIR)/misc -I$(MOD_DIR)/astra -I$(MOD_DIR)/sbr -I$(MOD_DIR)/feqis $(LIB)

# User defined sbr and fnc

$(LIBSBR): $(AWD)/sbr/*
	make -f $(AWD)/exe/Makesub sub=sbr

$(LIBFNC): $(AWD)/fnc/*.f90
	make -f $(AWD)/exe/Makesub sub=fnc

# Libs

$(LIBMISC): $(AWD)/src/misc/*
	make -f $(AWD)/exe/Makemisc lib

$(LIBASTRA): $(AWD)/src/astra/*
	make -f $(AWD)/exe/Makeastra lib

$(LIBNBI): $(AWD)/src/nbi/*
	cd $(AWD)/src; make -f $(AWD)/exe/Makenbi

$(LIBFEQIS): $(AWD)/src/feqis/*
	make -f $(AWD)/exe/Makefeqis lib
