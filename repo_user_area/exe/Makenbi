ifndef AWD
$(error setenv/export AWD first)
endif

SRC_DIR = $(AWD)/src/nbi
OBJ_DIR = $(AWD)/obj/nbi
MOD_ASTRA = $(AWD)/mod/astra
MOD_MISC = $(AWD)/mod/misc
MOD_DIR = $(AWD)/mod/nbi
LIB_DIR = $(AWD)/lib
LIBNAM = libnbi.a
LIB = $(LIB_DIR)/$(LIBNAM)

# Make Commands
.PHONY: all
all: directories $(LIB) mvmod

.PHONY: directories
directories:
	@mkdir -p $(LIB_DIR)
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(MOD_DIR)

.PHONY: mvmod
mvmod:
	rm -f *genmod.*
	-@mv *.mod $(MOD_DIR)/ 2>/dev/null; true

.PHONY: clean
clean:
	rm -f $(LIB)
	rm -rf $(OBJ_DIR)
	rm -f $(MOD_DIR)/*.mod

# Rules

OBJS = \
$(OBJ_DIR)/cross_sections.o \
$(OBJ_DIR)/nbstatus.o \
$(OBJ_DIR)/nbicom.o \
$(OBJ_DIR)/nbibce.o \
$(OBJ_DIR)/nb_injection.o

$(OBJ_DIR)%.o: $(SRC_DIR)%.f90
	$(FC) $(FC_FLAGS) -I$(MOD_MISC) -I$(MOD_ASTRA) -I$(MOD_DIR) -c $< -o $@

$(LIB): $(OBJS)
	ar rv $(LIB) $(OBJS) >/dev/null
	ranlib $(LIB)
