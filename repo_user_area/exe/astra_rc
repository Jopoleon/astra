#!/bin/bash -f

node=`uname -n`

# TORBEAM

IRC_LIB="-L${COMP_LIBDIR} -lirc" # necessary for libtorbeam.so
TORB_HOME="${ASTRA_EXT}/torbeam/aug21_ifort"  # needed at runtime too
TORB_LIBDIR=${TORB_HOME}/lib
export TORB_LIB="-L${TORB_LIBDIR} -ltorbeamB  -Wl,-rpath,${TORB_LIBDIR} ${IRC_LIB}"

# RABBIT

if [[ $node = "cx-ld-prod"* ]] || [[ $node = "hz-ld-"* ]] || [[ $node = "tok"* ]]
then
    RABBIT_HOME="${ASTRA_EXT}/rabbit/sep24"
    TGLF_HOME=${ASTRA_EXT}/tglf/jun24
else
    RABBIT_HOME="${ASTRA_EXT}/rabbit/may23"
    TGLF_HOME=${ASTRA_EXT}/tglf/oct22
fi

RABBIT_LIBDIR=${RABBIT_HOME}/lib
export RABBIT_LIB="-L${RABBIT_LIBDIR} -lrabbit -Wl,-rpath,${RABBIT_LIBDIR}"
export RABBIT_INC=${RABBIT_HOME}/inc

# QuaLiKiZ

QLK_HOME=${ASTRA_EXT}/qualikiz/apr23
export QLK_INC=${QLK_HOME}/inc
export QLK_LIB=${QLK_HOME}/lib/libQLK-intel-release-default-mpi.a

QLKNN_HOME=${ASTRA_EXT}/qlk_nn/apr21
export QLKNN_INC=${QLKNN_HOME}/inc/serial
export QLKNN_LIB=${QLKNN_HOME}/lib/libQLKNN-intel-release-default.a

# TGLF

export TGLF_INC=${TGLF_HOME}/inc
export TGLF_LIB=${TGLF_HOME}/lib/libtglf.a

# NEO

NEO_HOME=${ASTRA_EXT}/neo/apr21
NEO_LIBDIR=${NEO_HOME}/lib
export NEO_INC=${NEO_HOME}/inc
export NEO_LIB="${NEO_LIBDIR}/neo_lib.a ${NEO_LIBDIR}/nclass_lib.a ${NEO_LIBDIR}/UMFPACK_lib.a ${NEO_LIBDIR}/math_lib.a ${NEO_LIBDIR}/expro_lib.a ${NEO_LIBDIR}/geo_lib.a"
