#!/bin/bash -f

# IPP toki 21.07.2023

PKG=/mpcdf/soft/SLE_15/packages
NAG_LIBDIR=${PKG}/skylake/nag_flib/intel_2023.1.0.x-2023.1.0.x/24/lib
INTEL_HOME=${PKG}/x86_64/intel_oneapi/2023.1
COMP_LIBDIR=${INTEL_HOME}/compiler/2023.1.0/linux/compiler/lib/intel64_lin
export MKL_LIBDIR=${INTEL_HOME}/mkl/2023.1.0/lib/intel64
export IFORT_BIN=${INTEL_HOME}/compiler/2023.1.0/linux/bin/intel64

export INTEL_LICENSE_FILE=${PKG}/x86_64/intel_license/0.1
export NAG_KUSARI_FILE=lserv1.rzg.mpg.de:7733

export AFC=ifort
export ACC="cc -O"
export MPIFC=mpiifort

ASTRA_EXT=/afs/ipp/home/a/astra/ASTRA_LIBRARIES_EXT

# MPI
MPI_LIBDIR=${INTEL_HOME}/mpi/2021.9.0/lib

# NetCDF

NCDF_HOME=/afs/ipp/common/soft/netcdf/4.2.1.1/amd64_sles11/intel/14.0/impi-4.1.3
NCDF_LIBDIR=${NCDF_HOME}/lib
export NCDF_LIB="-L${NCDF_LIBDIR} -lnetcdf -lnetcdff -Wl,-rpath,${NCDF_LIBDIR}"
export NCDF_INC=${NCDF_HOME}/include

# TORBEAM

IRC_LIB="-L${COMP_LIBDIR} -lirc" # necessary for libtorbeam.so
TORB_HOME="${ASTRA_EXT}/torbeam/dec20"  # needed at runtime too
TORB_LIBDIR=${TORB_HOME}/lib
export TORB_LIB="-L${TORB_LIBDIR} -ltorbeamB -Wl,-rpath,${TORB_LIBDIR} ${IRC_LIB}"

# RABBIT

RABBIT_HOME="${ASTRA_EXT}/rabbit/may23"
RABBIT_LIBDIR=${RABBIT_HOME}/lib
export RABBIT_LIB="-L${RABBIT_LIBDIR} -lrabbit -Wl,-rpath,${RABBIT_LIBDIR}"
export RABBIT_INC=${RABBIT_HOME}/inc

# QuaLiKiZ

QLK_HOME=${ASTRA_EXT}/qualikiz/apr23
export QLK_INC=${QLK_HOME}/inc
export QLK_LIB=${QLK_HOME}/lib/libQLK-intel-release-default-mpi.a

QLKNN_HOME=${ASTRA_EXT}/qlk_nn/apr21
export QLKNN_INC=${QLKNN_HOME}/inc/serial
export QLKNN_LIB=${QLKNN_HOME}/lib/libQLKNN-intel-release-default.a

# TGLF

TGLF_HOME=${ASTRA_EXT}/tglf/oct22
export TGLF_INC=${TGLF_HOME}/inc
export TGLF_LIB=${TGLF_HOME}/lib/libtglf.a

# NEO

NEO_HOME=${ASTRA_EXT}/neo/apr21
NEO_LIBDIR=${NEO_HOME}/lib
export NEO_INC=${NEO_HOME}/inc
export NEO_LIB="${NEO_LIBDIR}/neo_lib.a ${NEO_LIBDIR}/nclass_lib.a ${NEO_LIBDIR}/UMFPACK_lib.a ${NEO_LIBDIR}/math_lib.a ${NEO_LIBDIR}/expro_lib.a ${NEO_LIBDIR}/geo_lib.a"

# NAGs

export NAGFLIB=${NAG_LIBDIR}/libnag_nag.a
export NAGF90MKL=${NAG_LIBDIR}/libnag_mkl.a

# XLBR

export XLBR="-L/usr/lib64 -lX11 -Wl,--start-group ${COMP_LIBDIR}/libintlc.so.5 ${MKL_LIBDIR}/libmkl_intel_lp64.a ${MKL_LIBDIR}/libmkl_core.a ${MKL_LIBDIR}/libmkl_sequential.a ${MKL_LIBDIR}/libmkl_blacs_intelmpi_lp64.a -Wl,--end-group"

export AS_LD_LIBRARY_PATH="${NAG_LIBDIR}:${MPI_LIBDIR}:${MPI_LIBDIR}/release"
