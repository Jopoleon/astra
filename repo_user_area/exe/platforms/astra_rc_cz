#!/bin/bash -f

# IPP CZ

NAG_LIBDIR="/compass/home/tardini/astra_ext/nag_lib"
COMP_LIBDIR="/sw/intel/compilers_and_libraries_2018.3.222/linux/compiler/lib/intel64_lin"

export MKL_LIBDIR="/sw/intel/compilers_and_libraries_2018.3.222/linux/mkl/lib/intel64"
NCDF_HOME="/sw/netcdf/4.6.3-intel18"
HDF5_HOME="/sw/hdf5/1.8.21-intel18"
NCDF_LIBDIR=${NCDF_HOME}/lib
HDF5_LIBDIR=${HDF5_HOME}/lib

export AFC=ifort
export ACC="cc -O"
export MPIFC=mpiifort

ASTRA_EXT=/compass/home/tardini/astra_ext

# NetCDF

export NCDF_LIB="-L${HDF5_LIBDIR} -lhdf5 -L${NCDF_LIBDIR} -lnetcdf -lnetcdff"
export NCDF_INC="${NCDF_HOME}/include"

CPLIBS="-L${COMP_LIBDIR} -lsvml -limf -lirng -lifport -lirc"

# TGLF

TGLF_HOME=${ASTRA_EXT}/tglf/oct22
export TGLF_INC=${TGLF_HOME}/inc
export TGLF_LIB=${TGLF_HOME}/lib/libtglf.a

# NEO

NEO_HOME=${ASTRA_EXT}/neo/jun21
export NEO_INC=${NEO_HOME}/inc
export NEO_LIB="${NEO_HOME}/lib/neo_lib.a ${NEO_HOME}/lib/nclass_lib.a ${NEO_HOME}/lib/UMFPACK_lib.a ${NEO_HOME}/lib/math_lib.a ${NEO_HOME}/lib/expro_lib.a ${NEO_HOME}/lib/geo_lib.a"

# NAGs

export NAGFLIB=${NAG_LIBDIR}/libnag_nag.a
export NAGF90MKL=${NAG_LIBDIR}/libnag_mkl.a

# TORBEAM

IRC_LIB="-L${COMP_LIBDIR} -lirc" # necessary for libtorbeam.so
TORB_HOME="${ASTRA_EXT}/torbeam" # needed at runtime too
TORB_LIBDIR=${TORB_HOME}/lib
export TORB_LIB="-L${TORB_LIBDIR} -ltorbeam ${CPLIBS} ${NAGFLIB} ${NAGF90MKL}"

# RABBIT

RABBIT_HOME="${ASTRA_EXT}/rabbit/jul22"
RABBIT_LIBDIR=${RABBIT_HOME}/lib
export RABBIT_LIB="-L${RABBIT_LIBDIR} -lrabbit -Wl,-rpath,${RABBIT_LIBDIR}"
export RABBIT_INC=${RABBIT_HOME}/inc

# QuaLiKiZ

QLK_HOME=${ASTRA_EXT}/qualikiz/jun21
export QLK_INC=${QLK_HOME}/inc
export QLK_LIB=${QLK_HOME}/lib/libQLK-intel-release-default-mpi.a

QLKNN_HOME=${ASTRA_EXT}/qlk_nn/jun21
export QLKNN_INC=${QLKNN_HOME}/inc/serial
export QLKNN_LIB=${QLKNN_HOME}/lib/libQLKNN-intel-release-default.a

# XLBR

export XLBR="-L/usr/lib -lX11 -Wl,--start-group ${MKL_LIBDIR}/libmkl_intel_lp64.a ${COMP_LIBDIR}/libintlc.so.5 ${MKL_LIBDIR}/libmkl_core.a ${MKL_LIBDIR}/libmkl_sequential.a -Wl,--end-group ${MKL_LIBDIR}/libmkl_blacs_intelmpi_lp64.a"

export AS_LD_LIBRARY_PATH="${HDF5_HOME}/lib:${NCDF_LIBDIR}:${NAG_LIBDIR}:${COMP_LIBDIR}:${TORB_LIBDIR}:${RABBIT_LIBDIR}"
