# IPP toki 05.06.2020

export PKG=/work/imas/opt/EasyBuild/software
export MKL_LIBDIR=${PKG}/imkl/2020.4.304-iimpi-2020b/mkl/lib/intel64
export NAGLIB=${PKG}/NAG/26-intel-2020b/lib
ADDLIB=${PKG}/NAG/26-intel-2020b/rtl/intel64
COMP_HOME=${PKG}/iccifort/2020.4.304/compilers_and_libraries_2020.4.304/linux
export COMP_LIB=${COMP_HOME}/compiler/lib/intel64
