#!/bin/bash -f

# IPP toki 05.06.2020

PKG=/work/imas/opt/EasyBuild/software
NAG_LIBDIR=${PKG}/NAG/26-intel-2020b/lib
ADDLIB=${PKG}/NAG/26-intel-2020b/rtl/intel64
COMP_HOME=${PKG}/iccifort/2020.4.304/compilers_and_libraries_2020.4.304/linux
COMP_LIBDIR=${COMP_HOME}/compiler/lib/intel64

export MKL_LIBDIR=${PKG}/imkl/2020.4.304-iimpi-2020b/mkl/lib/intel64
export I_MPI_ROOT=${PKG}/impi/2019.9.304-iccifort-2020.4.304
export IFORT_BIN=${COMP_HOME}/bin/intel64
export MPIFORT_BIN=${I_MPI_ROOT}/intel64/bin
export INTEL_LICENSE_FILE=27010@io-ws-ls1

export AFC=ifort
export ACC="cc -O"
export MPIFC=mpiifort

ASTRA_EXT=/home/ITER/tarding/ASTRA_LIBRARIES_EXT

# MPI

MPI_LIBDIR=${I_MPI_ROOT}/intel64/lib/release
export MPI_LIB="-L${MPI_LIBDIR} -lmpi -L${I_MPI_ROOT}/intel64/lib -lmpifort"
export MPI_INC="-I${I_MPI_ROOT}/intel64/include"

# NetCDF

HDF5_HOME=${PKG}/HDF5/1.10.7-iimpi-2020b
HDF5_LIBDIR=${HDF5_HOME}/lib64
export HDF5_LIB="-L${HDF5_LIBDIR} -lhdf5 -lhdf5_hl"
#export NCDF_HOME=/home/ITER/weilanm/fortran/netcdf-4.1.3/intel/19.0.3
#export NCDF_INC=${NCDF_HOME}/fortran
#export NCDF_LIB="${HDF5_LIB} -L${NCDF_HOME}/fortran/.libs -lnetcdff"
NCDF_HOME=${PKG}/netCDF/4.7.4-iimpi-2020b
NCDFF_HOME=${PKG}/netCDF-Fortran/4.5.3-iimpi-2020b
NCDF_LIBDIR=${NCDF_HOME}/lib
NCDFF_LIBDIR=${NCDFF_HOME}/lib
export NCDF_LIB="${HDF5_LIB} -L${NCDF_LIBDIR} -lnetcdf -L${NCDFF_LIBDIR} -lnetcdff"
export NCDF_INC="${NCDFF_HOME}/include"

# TORBEAM

IRC_LIB="-L${COMP_LIBDIR} -lirc" # necessary for libtorbeam.so
TORB_HOME="${ASTRA_EXT}/torbeam/dec20"  # needed at runtime too
TORB_LIBDIR=${TORB_HOME}/lib
export TORB_LIB="-L${TORB_LIBDIR} -ltorbeamB ${IRC_LIB}"

# RABBIT

RABBIT_HOME="${ASTRA_EXT}/rabbit/jul22"
RABBIT_LIBDIR=${RABBIT_HOME}/lib
export RABBIT_LIB="-L${RABBIT_LIBDIR} -lRabbitMore -Wl,-rpath,${RABBIT_LIBDIR}"
export RABBIT_INC=${RABBIT_HOME}/inc

# QuaLiKiZ

QLK_HOME=${ASTRA_EXT}/qualikiz/apr21
export QLK_INC=${QLK_HOME}/inc
export QLK_LIB=${QLK_HOME}/lib/libQLK-intel-release-default-mpi.a

QLKNN_HOME=${ASTRA_EXT}/qlk_nn/apr21
export QLKNN_INC=${QLKNN_HOME}/inc
export QLKNN_LIB=${QLKNN_HOME}/lib/libQLKNN-intel-release-default.a

# TGLF

TGLF_HOME=${ASTRA_EXT}/tglf/oct22
export TGLF_INC=${TGLF_HOME}/inc
export TGLF_LIB=${TGLF_HOME}/lib/libtglf.a

# NEO

NEO_HOME=${ASTRA_EXT}/neo/apr21
NEO_LIBDIR=${NEO_HOME}/lib
export NEO_INC=${NEO_HOME}/inc
export NEO_LIB="${NEO_LIBDIR}/neo_lib.a ${NEO_LIBDIR}/nclass_lib.a ${NEO_LIBDIR}/UMFPACK_lib.a ${NEO_LIBDIR}/math_lib.a ${NEO_LIBDIR}/expro_lib.a ${NEO_LIBDIR}/geo_lib.a"

# NAGs

export NAGFLIB=${NAG_LIBDIR}/libnag_nag.a
export NAGF90MKL=${NAG_LIBDIR}/libnag_mkl.a

# XLBR

export XLBR="-L/usr/lib64 -lX11 -Wl,--start-group ${COMP_LIBDIR}/libintlc.so.5 ${MKL_LIBDIR}/libmkl_intel_lp64.a ${MKL_LIBDIR}/libmkl_core.a ${MKL_LIBDIR}/libmkl_sequential.a ${MKL_LIBDIR}/libmkl_blacs_intelmpi_lp64.a -Wl,--end-group"

export AS_LD_LIBRARY_PATH="${HDF5_LIBDIR}:${NCDF_LIBDIR}:${NCDFF_LIBDIR}:${ADDLIB}:${NAG_LIBDIR}:${COMP_LIBDIR}:${TORB_LIBDIR}:${RABBIT_LIBDIR}:${MPI_LIBDIR}:${PKG}/Szip/2.1.1-GCCcore-10.2.0/lib:${PKG}/PMIx/3.1.5-GCCcore-10.2.0/lib"
