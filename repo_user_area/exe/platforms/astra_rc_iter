export NBI_INC=${NBI_HOME}/inc

# EQUIL

export EQUIL_LIB="-L${ACORE_HOME}/lib -lequil"

# ASTRA_CORE

export ACORE_LIB="-L${ACORE_HOME}/lib -lfor"
