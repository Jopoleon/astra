#!/bin/bash -f

PKG=/fusion/usc/opt/intel2019
NAG_LIBDIR=joe_OPEN_ASTRA_RC_please
COMP_LIBDIR=${PKG}/compilers_and_libraries/linux/lib/intel64
export I_MPI_ROOT=/fusion/usc/opt/mpich/mpich-3.2/intel2018

export MKL_LIBDIR=${PKG}/compilers_and_libraries/linux/mkl/lib/intel64
export IFORT_BIN=${PKG}/compilers_and_libraries/linux/bin/intel64
export MPIFORT_BIN=/fusion/usc/opt/mpich/mpich-3.2/intel2018/bin
export INTEL_LICENSE_FILE=${PKG}/licenses

export AFC=ifort
export ACC="gcc -O"
export MPIFC=mpifort

ASTRA_EXT=/fusion/projects/codes/astra/ASTRA_LIBRARIES_EXT

# MPI
MPI_LIBDIR=${MPI_LIB}/lib
export MPI_LIB="-L${MPI_LIBDIR} -lmpi"
export MPI_INC="-I${I_MPI_ROOT}/include"

# NetCDF

# Joe: found these vaues from /fusion/projects/theory/gacode/platform/build/make.inc.IRIS
NCDF_HOME=/fusion/projects/theory/HPC
NCDF_LIBDIR=${NCDF_HOME}/netcdf/lib
NCDFF_LIBDIR=${NCDF_HOME}/fortran/lib
export NCDF_LIB="-L${NCDFF_LIBDIR} -lnetcdff -L${NCDF_LIBDIR} -lnetcdf -L${COMP_LIBDIR} -ldl -lm -lifport -lintlc -lifcoremt -limf -lsvml -lifcore"
export NCDF_INC=${NCDF_HOME}/fortran/include

# TORBEAM

IRC_LIB="-L${COMP_LIBDIR} -lirc" # necessary for libtorbeam.so
TORB_HOME="${ASTRA_EXT}/torbeam/aug21_ifort"
TORB_LIBDIR=${TORB_HOME}/lib
export TORB_LIB="-L${TORB_LIBDIR} -ltorbeamB  -Wl,-rpath,${TORB_LIBDIR} ${IRC_LIB}"

# RABBIT

RABBIT_HOME="/fusion/projects/toolbox/energetic_particles/weilandm/rabbit/v4.0.1"
RABBIT_LIBDIR=${RABBIT_HOME}
export RABBIT_LIB="-L${RABBIT_LIBDIR} -lrabbit -Wl,-rpath,${RABBIT_LIBDIR}"
export RABBIT_INC=${RABBIT_HOME}/modules

# QuaLiKiZ

QLK_HOME=${ASTRA_EXT}/qualikiz/apr21
export QLK_INC=${QLK_HOME}/inc
export QLK_LIB=${QLK_HOME}/lib/libqualikiz.a

QLKNN_HOME=${ASTRA_EXT}/qlk_nn/apr21
export QLKNN_INC=${QLKNN_HOME}/inc/serial
export QLKNN_LIB=${QLKNN_HOME}/lib/libQLKNN-intel-release-default.a

# TGLF

TGLF_HOME=${ASTRA_EXT}/tglf/oct22
export TGLF_INC=${TGLF_HOME}/inc
export TGLF_LIB=${TGLF_HOME}/lib/libtglf.a

# NEO

NEO_HOME=${ASTRA_EXT}/neo/apr21
NEO_LIBDIR=${NEO_HOME}/lib
export NEO_INC=${NEO_HOME}/inc
export NEO_LIB="${NEO_LIBDIR}/neo_lib.a ${NEO_LIBDIR}/nclass_lib.a ${NEO_LIBDIR}/UMFPACK_lib.a ${NEO_LIBDIR}/math_lib.a ${NEO_LIBDIR}/expro_lib.a ${NEO_LIBDIR}/geo_lib.a"

# NAGs

export NAGFLIB=${NAG_LIBDIR}/libnag_nag.a
export NAGF90MKL=${NAG_LIBDIR}/libnag_mkl.a

# XLBR

export XLBR="-L/usr/lib64 -lX11 -Wl,--start-group ${COMP_LIBDIR}/libintlc.so.5 ${MKL_LIBDIR}/libmkl_intel_lp64.a ${MKL_LIBDIR}/libmkl_core.a ${MKL_LIBDIR}/libmkl_sequential.a ${MKL_LIBDIR}/libmkl_blacs_intelmpi_lp64.a -Wl,--end-group"

export AS_LD_LIBRARY_PATH="${NCDF_LIBDIR}:${NCDFF_LIBDIR}:${COMP_LIBDIR}:${NAG_LIBDIR}"
