$(OBJ_DIR)/ctr2rz.o \
$(OBJ_DIR)/four_mom.o

# Make Commands

.PHONY: modules
modules: directories $(MODOBJS) mvmod

.PHONY: lib
lib: $(LIB)

.PHONY: directories
directories:
	@mkdir -p $(MOD_DIR)
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(LIB_DIR)

.PHONY: mvmod
mvmod:
	rm -f *genmod.*
	-@mv *.mod $(MOD_DIR)/ 2>/dev/null; true

.PHONY: clean
clean:
	rm -f *.mod
	rm -f $(MOD_DIR)/*.mod
	rm -rf $(OBJ_DIR)
	rm -f $(LIB)

# Rules

$(OBJ_DIR)%.o: $(SRC_DIR)%.f90
	$(FC) $(FC_FLAGS) -I$(MOD_DIR) -I$(MOD_FEQ) -I$(JSON_INC) -c $< -o $@

$(OBJ_DIR)%.o: $(SRC_DIR)%.c
	$(CC) -c $< -o $@ -I$(INC_DIR)

$(LIB): $(MODOBJS) $(OBJS)
	ar rv $(LIB) $(MODOBJS) $(OBJS) >/dev/null
#	ranlib $(LIB)
