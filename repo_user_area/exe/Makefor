$(OBJ_DIR)/surf_ctr.o \
$(OBJ_DIR)/ctr2rz.o \
$(OBJ_DIR)/four_mom.o

# Make Commands

.PHONY: modules
modules: directories $(MODOBJS) mvmod

.PHONY: lib
lib: $(LIB)

.PHONY: directories
directories:
	@mkdir -p $(MOD_DIR)
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(LIB_DIR)

.PHONY: mvmod
mvmod:
	rm -f *genmod.*
	-@mv *.mod $(MOD_DIR)/ 2>/dev/null

.PHONY: clean
clean:
	rm -f *.mod
	rm -f $(MOD_DIR)/*.mod
	rm -rf $(OBJ_DIR)
	rm -f $(LIB)

# Rules

$(OBJ_DIR)%.o: $(SRC_DIR)%.f90
	$(AFC) $(AFC_FLAGS) -I$(MOD_DIR) -I$(MOD_FEQ) -c $< -o $@

$(OBJ_DIR)%.o: $(SRC_DIR)%.c
	$(ACC) -c $< -o $@

$(LIB): $(MODOBJS) $(OBJS)
	ar rv $(LIB) $(MODOBJS) $(OBJS) >/dev/null
#	ranlib $(LIB)
