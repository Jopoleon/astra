SRC_DIR = $(AWD)/ipc
OBJ_DIR = $(AWD)/obj/ipc
INC_DIR = $(AWD)/inc
MOD_DIR = $(AWD)/mod/for
LIB_DIR = $(AWD)/lib
LIB = $(LIB_DIR)/libipc.a

AFC_FLAGS = -r8 -no-prec-div -ip -O0 -w -qopenmp
ACC = cc

SRCF90 := $(wildcard $(SRC_DIR)/*.f90)
SRCC   := $(wildcard $(SRC_DIR)/*.c)

OBJF90 := $(patsubst $(SRC_DIR)%.f90, $(OBJ_DIR)%.o, $(SRCF90))
OBJIPC = \
$(OBJ_DIR)/neointer.o \
$(OBJ_DIR)/tglfinter.o \
$(OBJ_DIR)/qlkinter.o

# Make Commands
.PHONY: all
all: directories $(LIB)

.PHONY: directories
directories:
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(LIB_DIR)

.PHONY: clean
clean:
	rm -rf $(OBJ_DIR)
	rm $(LIB)

$(OBJ_DIR)/neointer.o:    $(SRC_DIR)/tra_interf.c
		$(ACC) -I$(INC_DIR) -o $@ -c $< -Dneo

$(OBJ_DIR)/tglfinter.o:   $(SRC_DIR)/tra_interf.c
		$(ACC) -I$(INC_DIR) -o $@ -c $< -Dtglf

$(OBJ_DIR)/qlkinter.o:    $(SRC_DIR)/tra_interf.c
		$(ACC) -I$(INC_DIR) -o $@ -c $< -Dqlk

$(OBJ_DIR)%.o: $(SRC_DIR)%.f90
	$(AFC) $(AFC_FLAGS) -I$(MOD_DIR) -c $< -o $@

$(OBJ_DIR)%.o: $(SRC_DIR)%.c
	$(ACC) -I$(INC_DIR) -o $@ -c $<

OBJIPC = \
$(OBJ_DIR)/neointer.o \
$(OBJ_DIR)/tglfinter.o \
$(OBJ_DIR)/qlkinter.o \
$(OBJ_DIR)/io_tra.o \
$(OBJ_DIR)/ipc_control.o

$(LIB): $(OBJF90) $(OBJF) $(OBJIPC)
	ar rv $(LIB) $(OBJF90) >/dev/null
	ar rv $(LIB) $(OBJIPC) >/dev/null
	ranlib $(LIB)
