ifndef AWD
$(error setenv/export AWD first)
endif

SRC_DIR = $(AWD)/src/feqis
OBJ_DIR = $(AWD)/obj/feqis
MOD_FOR = $(AWD)/mod/for
MOD_DIR = $(AWD)/mod/feqis
LIB_DIR = $(AWD)/lib
LIBNAM = libfeqis.a
LIB = $(LIB_DIR)/$(LIBNAM)

FFLAGS	= -O2 -g -fPIC -traceback $(CHECKALLCOMP)

# FEQIS objs

FEQ_MODOBJ = \
$(OBJ_DIR)/modules_core.o \
$(OBJ_DIR)/modules_feqis.o \
$(OBJ_DIR)/feqis_tools.o \
$(OBJ_DIR)/fbe_core.o \
$(OBJ_DIR)/pbe_core.o \
$(OBJ_DIR)/feqis_circuit_mod.o

FEQ_LIBOBJ = \
$(OBJ_DIR)/solver_inversion_matrix_gsef.o \
$(OBJ_DIR)/feqis_main.o \
$(OBJ_DIR)/wrappers.o \
$(OBJ_DIR)/PHI_EQ_2d_PBE.o \
$(OBJ_DIR)/jacobians.o \
$(OBJ_DIR)/build_2dgrid.o 

# Make Commands

.PHONY: modules
modules: directories $(FEQ_MODOBJ) mvmod

.PHONY: lib
lib: $(LIB)

.PHONY: directories
directories:
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(LIB_DIR)
	@mkdir -p $(MOD_DIR)

.PHONY: mvmod
mvmod:
	rm -f *genmod.*
	-@mv *.mod $(MOD_DIR)/ 2>/dev/null; true

.PHONY: clean
clean:
	rm -rf $(OBJ_DIR)
	rm -f $(MOD_DIR)/*.mod
	rm -f *.mod
	rm -f $(LIB)

# Rules

$(OBJ_DIR)%.o : $(SRC_DIR)%.f90
	$(FC) $(FFLAGS) -I. -I$(MOD_DIR) -I$(MOD_FOR) -I$(JSON_INC) -c $< -o $@

$(LIB): $(FEQ_MODOBJ) $(FEQ_LIBOBJ)
	ar -u -rv $(LIB) $(FEQ_MODOBJ) $(FEQ_LIBOBJ)
