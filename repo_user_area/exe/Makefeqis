SRC_DIR = $(AWD)/src/feqis
OBJ_DIR = $(AWD)/obj/feqis
MOD_FOR = $(AWD)/mod/for
MOD_DIR = $(AWD)/mod/feqis
LIB_DIR = $(AWD)/lib
LIBNAM = libfeqis.a
LIB = $(LIB_DIR)/$(LIBNAM)

FFLAGS	= -O2 -g -traceback -I$(MOD_FOR) -I$(MOD_DIR)

# FEQIS objs

FEQ_MODOBJ = \
$(OBJ_DIR)/modules_feqis.o

FEQ_LIBOBJ = \
$(OBJ_DIR)/interp_feqis.o \
$(OBJ_DIR)/feqis_main.o \
$(OBJ_DIR)/build_2dgrid.o \
$(OBJ_DIR)/jacobians.o \
$(OBJ_DIR)/PHI_EQ_2d_PBE.o \
$(OBJ_DIR)/solver_inversion_matrix_gsef.o

# Coupling scheme objs

# Make Commands
.PHONY: all
all: directories $(LIB)

.PHONY: directories
directories:
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(LIB_DIR)
	@mkdir -p $(MOD_DIR)

.PHONY: clean
clean:
	rm -rf $(OBJ_DIR)
	rm -f $(MOD_DIR)/*.mod
	rm -f *.mod
	rm -f $(LIB)

# Rules

$(OBJ_DIR)%.o : $(SRC_DIR)%.f90
	$(AFC) $(FFLAGS) -c $< -o $@
	-@mv *.mod $(MOD_DIR)/

$(LIB): $(FEQ_MODOBJ) $(FEQ_LIBOBJ)
	ar -u -rv $(LIB) $(FEQ_MODOBJ) $(FEQ_LIBOBJ)
