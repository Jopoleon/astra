# Coupling scheme objs

# Make Commands
.PHONY: all
all: directories $(LIB) mvmod

.PHONY: directories
directories:
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(LIB_DIR)
	@mkdir -p $(MOD_DIR)


.PHONY: mvmod
mvmod:
	-@mv *.mod $(MOD_DIR)/ 2>/dev/null

.PHONY: clean
clean:
	rm -rf $(OBJ_DIR)
	rm -f $(MOD_DIR)/*.mod
	rm -f *.mod
	rm -f $(LIB)

# Rules

$(OBJ_DIR)%.o : $(SRC_DIR)%.f
	$(AFC) $(FFLAGS) -c $< -o $@

$(OBJ_DIR)%.o : $(SRC_DIR)%.f90
	$(AFC) $(FFLAGS) -c $< -o $@

$(LIB): $(SPMODOBJS) $(SPOBJS)
	ar -u -rv $(LIB) $(SPMODOBJS) $(SPOBJS)
