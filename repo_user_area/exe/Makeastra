ifndef AWD
$(error setenv/export AWD first)
endif

SRC_DIR = $(AWD)/src/astra
OBJ_DIR = $(AWD)/obj/astra
MOD_DIR = $(AWD)/mod/astra
INC_DIR = $(AWD)/inc
MOD_FEQ = $(AWD)/mod/feqis
MOD_TYP = $(AWD)/mod/misc

LIB_DIR = $(AWD)/lib
LIBNAM = libastra.a
LIBTYP = libmisc.a
LIB = $(LIB_DIR)/$(LIBNAM)

# Compilers

FC_FLAGS = -r8 -no-prec-div -traceback -ip -fPIC -O0 $(CHECKALLCOMP)

MODOBJS = \
$(OBJ_DIR)/json_vars.o \
$(OBJ_DIR)/debugger.o \
$(OBJ_DIR)/machine_config.o \
$(OBJ_DIR)/parse_utils.o \
$(OBJ_DIR)/emeq.o \
$(OBJ_DIR)/scalars.o \
$(OBJ_DIR)/read_input.o \
$(OBJ_DIR)/time_functions.o \
$(OBJ_DIR)/status.o \
$(OBJ_DIR)/transport_solver.o \
$(OBJ_DIR)/standard_functions.o \
$(OBJ_DIR)/cpu_usage.o \
$(OBJ_DIR)/parameters_a2equil.o \
$(OBJ_DIR)/surface_contours.o \
$(OBJ_DIR)/flux_avg_imp.o \
$(OBJ_DIR)/json_rw.o \
$(OBJ_DIR)/gs_solver.o \
$(OBJ_DIR)/metrics.o \
$(OBJ_DIR)/auxiliary.o \
$(OBJ_DIR)/set_x_data.o

OBJS = $(OBJ_DIR)/ipc_control.o

# Make Commands

.PHONY: modules
modules: directories $(MODOBJS) mvmod

.PHONY: lib
lib: $(LIB)

.PHONY: directories
directories:
	@mkdir -p $(MOD_DIR)
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(LIB_DIR)

.PHONY: mvmod
mvmod:
	rm -f *genmod.*
	-@mv *.mod $(MOD_DIR)/ 2>/dev/null; true

.PHONY: clean
clean:
	rm -f *.mod
	rm -f $(MOD_DIR)/*.mod
	rm -rf $(OBJ_DIR)
	rm -f $(LIB)

# Rules

$(OBJ_DIR)%.o: $(SRC_DIR)%.f90
	$(FC) $(FC_FLAGS) -I$(MOD_TYP) -I$(MOD_DIR) -I$(MOD_FEQ) -I$(JSON_INC) -c $< -o $@

$(OBJ_DIR)%.o: $(SRC_DIR)%.c
	$(CC) -fPIC -c $< -o $@ -I$(INC_DIR)

$(LIB): $(MODOBJS) $(OBJS)
	ar rv $(LIB) $(MODOBJS) $(OBJS) >/dev/null
