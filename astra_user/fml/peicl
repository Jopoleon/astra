! PEICL [MW/m#3]: Electron ion heat exchange due to Coulomb collisions
! PEICL=3/tauei*Ne*(Te-Ti)*m/M
!  here tauei[sec]=1.1E-3*T_{e, keV}^{3/2}/[Z_i^2*n_{i, 19}*\Lambda]
! Usage:
!  PE=...-PEICL
!  PI=...+PEICL
!   (Pereverzev 22-APR-87)
!   (Corrected  26-MAR-97)
include 'fml/coulg'
PEICL=0.00246*COULG*NE(J)*NI(J)*ZMAIN(J)*ZMAIN(J)
PEICL=PEICL*(TE(J)-TI(J))/(AMAIN(J)*TE(J)*SQRT(TE(J)))
