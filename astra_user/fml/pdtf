! This formula is outdated and non-compatible with the current
! version of the NBI routine. The parameters ABEAM, EBEAM are not
! defined. The subroutine cannot be called from a model any more.
!    (Pereverzev March 2002)
! PDTF [MW/m#3]   D-T Fusion power thermal  + NB
! S.V.Putvinskij//VANT, v.2, 1988, p.3
! Corrected by S.V.Putvinskij 22.11.89
!    Polevoy  06-JUL-99
ABEAM = 2.
EBEAM = 1000.
include 'fml/svdt'
if (ABEAM .eq. 1 .or. NIBM(j) .le. 0.) then
 PDTF = 5.632*NDEUT(J)*NTRIT(J)*SVDT
else
!.......Logarithm e
YLE =15.85+LOG(TE(J)/SQRT(NE(J)))
Y =3.1E-4*(17590./SQRT(EBEAM))*2.*ABEAM
if (ABEAM .eq. 2) then
 YECM =0.6*EBEAM
 YSQ =SQRT(YECM)
 YJ =Y*NTRIT(J)/NE(J)*TE(J)*SQRT(TE(J))/YLE
 PDTF = 5.632*(NDEUT(J)-NIBM(j))*NTRIT(J)*SVDT
endif 
if (ABEAM .eq. 3) then
 YECM =0.4*EBEAM
 YSQ =SQRT(YECM)
 YJ =Y*NDEUT(J)/NE(J)*TE(J)*SQRT(TE(J))/YLE
 PDTF = 5.632*(NTRIT(J)-NIBM(j))*NDEUT(J)*SVDT
endif 
   YS =0.
 YSUM =0.
  YECDEB =10.*TE(J)*ABEAM/EBEAM
  YXC3 =YECDEB*SQRT(YECDEB)
DO  JK = 1, 99
YX =.01*JK
YX2 =YX*YX
YX3 =YX2*YX
YE =YECM*YX2
YS2 =(YE-48.7878)**2
YSIG =EXP(-34.3812/YX/YSQ)*(1.+1.1177E-5*YS2)/    (1.+6.433E-4*YS2)/YE
  YSUM =YSUM+ YSIG/(1.+YXC3/YX3)
 enddo
PDTF =PDTF+.2*26798.*.01*YSUM*YJ*PBEAM(J) 
endif 
