! betpl: Beta poloidal local total
!  Fable May 2014
! betpl=4*pi*(ne*Te+ni*Ti)/Bpo**2
!
if (J.ne.NA1) then
   ZF1=(NE(J+1)+NE(J))*(TE(J+1)+TE(J))
   ZF2=(NI(J+1)+NI(J))*(TI(J+1)+TI(J))
   BETPT = 1.6E-4*GP*(ZF1+ZF2)
   BETPT = BETPT*(RTOR/(BTOR*J*HRO*ABS(MU(J)+.0001)))**2
else
   ZF1=NE(J)*TE(J)
   ZF2=NI(J)*TI(J)
   BETPT = 6.4E-4*GP*(ZF1+ZF2)
   BETPT = BETPT*(RTOR/(BTOR*ROC*ABS(MU(J)+.0001)))**2
endif 
