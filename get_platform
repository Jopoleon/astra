#!/bin/bash -f

rootdir=`dirname $0`          # may be relative path
AWD=`cd $rootdir && pwd`  # ensure absolute path
node=`uname -n`

if [[ $AWD == "/afs/ipp"* ]]
then
   if [[ $node == "lxts"* ]]
   then
      platform=lx
   else
      platform=tok
   fi
elif [[ $AWD == "/tokp/work"* ]]
then
   platform=tok
elif [[ $AWD == "/toks/work"* ]]
then
   platform=tok
elif [[ $AWD == "/afs/eufus"* ]]
then
   platform=gway
elif [[ $AWD == "/localhome"* ]]
then
   platform=goblin
elif [[ $AWD == "/home/ITER"* ]]
then
   platform=iter
elif [[ $AWD == "/compass"* ]]
then
   platform=cz
elif [[ $node == *"mit.edu" ]]
then
   platform=mit
elif [[ $node == "CX-LD-AUG"* ]]
then
   platform=ldaug
else
   platform=ga
fi

echo $platform
