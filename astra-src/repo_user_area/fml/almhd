!----------------------------------------------------------------------|
! ALMHD []: MHD alpha (r) defined as
! CGS: \alpha_MHD = -2*R_0*[dp/d\rho]*4\pi[q/B]^2
! SI:  \alpha_MHD = -2*R_0*[dp/d\rho]*\mu_0[q/B]^2
!      (Pereverzev 12-JAN-90)
!----------------------------------------------------------------------|

ALMHD = (NE(j+1)*TE(j+1) - NE(j)*TE(j) + NI(j+1)*TI(j+1) - NI(j)*TI(j))/HRO
ALMHD = -4.02E-3*RTOR*ALMHD/(MU(j)*BTOR)**2
