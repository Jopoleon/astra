! SNNEU [1/s]: S/Ne=<sigE*v>*Nn+<sigI*v>*Nn*Ni/Ne-<sigRC*v>*Ne
! particle Source due to Neutral ionization by Electron and Ion impact
!  SNN=SNNEU   (Pereverzev 22-MARCH-91)
!      Notations changed 11-FEB-09
include 'fml/svie'
include 'fml/svii'
include 'fml/svrec'
SNNEU = (SVIE+SVII*NI(J)/NE(J))*(NNCL+NNWM)*NN(J)-SVREC*NI(J)
