! HATLI [m#2/s]:  Heat conductivity Anomalous by Taroni for L-mode
!      BOHM=c*Te/(e*B)=TE/BTOR*10^3[m^2/s]
!      HATL=A_e*BOHM*q^2*(dp/dr)*a/p;    A_e recommended = 3.3E-4
!                        (Pereverzev 04-AUG-95)
!                        Source: M.Erba et al. JET-R(95)02

if (J == 1) then
    YHATLI = 0.
else
    YHATLI = 2.*ROC/HRO * &
        abs(NE(J)*TE(J)+NI(J)*TI(J)-NE(J-1)*TE(J-1)-NI(J-1)*TI(J-1))/&
        (NE(J)*TE(J)+NI(J)*TI(J)+NE(J-1)*TE(J-1)+NI(J-1)*TI(J-1))
endif

HATLy = 0.33*TE(J)/BTOR*YHATLI/MU(J)**2
if (isnan(hatly)) hatly = 0.01
