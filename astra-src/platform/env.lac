#!/bin/bash
## install on SPC-lac cluster (tested on lac5 and lac10)
## Note: based on a simple user install by Reinart Coosemans (username cooseman) at the moment, might be generalised later

export PYTHON_BIN=/lacdata/users/cooseman/astra8env/bin/python
export ASTRA_EXT=/lacdata/users/cooseman/soft

## setting compilers etc.
INTEL_DIR=/opt/intel/oneapi
export MKL_LIBDIR=${INTEL_DIR}/mkl/latest/lib/intel64
export COMP_LIBDIR=${INTEL_DIR}/compiler/latest/lib
COMP_BIN=${INTEL_DIR}/compiler/latest/bin
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifx
export MPIFC=mpiifx # trying this now, let's see
export CC=icx

## Create directory to store tcvout files
# Create tcvsimdat folder if it didn't exist yet
if ! [[ -d $AWD/dat/tcvsimdat/ ]]
  then
    echo 'creating folder AWD/dat/tcvsimdat/'
	mkdir $AWD/dat/tcvsimdat
fi
# Create directory for current run
if [[ -e $AWD/dirresults ]]
then
  dirname=$(cat $AWD/dirresults)
else
  echo 'AWD/dirresults does not exist, probably will result in error'
fi
if [[ -d $dirname ]]
then
  echo 'shell' $SHELL
  echo 'directory exists' $dirname
  rm -r $dirname
  mkdir $dirname
else
  mkdir $dirname
fi


