#!/bin/bash

module load cineca-modules/1.0 intel-oneapi-compilers/2024.1.0 intel-oneapi-mkl/2024.0.0--intel-oneapi-mpi--2021.12.1 netcdf-c/4.9.2--oneapi--2024.1.0 netcdf-fortran/4.6.1--oneapi--2024.1.0

export I_MPI_FABRICS=shm
export COMP_LIBDIR=$INTEL_ONEAPI_COMPILERS_HOME/2024.1/lib
export MKL_LIBDIR=$MKLROOT/lib
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export PYTHONHOME=/afs/eufus.eu/user/g/g2gtardi/miniforge3/2024.09
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

PYTHON_BINDIR=${PYTHONHOME}/bin
if [[ ":$PATH:" != *":$PYTHON_BINDIR:"* ]]
then
    export PATH=${PYTHON_BINDIR}:${PATH}
fi

export ASTRA_EXT=/afs/eufus.eu/user/g/g2gtardi/ASTRA_LIBRARIES_EXT
export FC=ifx
export CC=icx
export MPIFC=mpiifx
export MPICC=mpiicx
