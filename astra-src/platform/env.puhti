#!/bin/bash 
module purge
module load python-data
module load intel-oneapi-compilers
module load intel-oneapi-mkl
module load openmpi

export MKL_LIBDIR=/appl/spack/v018/install-tree/gcc-8.5.0/intel-oneapi-mkl-2022.1.0-v37qbm/mkl/2022.1.0/lib/intel64
export FC=ifort
export CC=icc
export MPIFC=mpifort
export MPICC=mpicc
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

export ASTRA_EXT=/projappl/project_2007159/ASTRA_LIBRARIES_EXT
