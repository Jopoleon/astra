#!/bin/bash

PKG=/opt/intel/oneapi
export I_MPI_ROOT=${PKG}/mpi/2021.10.0
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/2022.1.0/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2022.1.0/linux/compiler/lib/intel64
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifort
export CC=icc
export MPIFC=mpiifort
export MPICC=mpiicc
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

COMP_BINDIR=${PKG}/compiler/2022.1.0/linux/bin/intel64
MPI_BINDIR=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BINDIR:"* ]]
then
    export PATH=${COMP_BINDIR}:${MPI_BINDIR}:${PATH}
fi

export PYTHON_BINDIR=/global/common/software/nersc/pe/conda-envs/24.1.0/python-3.11/nersc-python/bin

export ASTRA_EXT=/global/cfs/cdirs/m2116/ASTRA_LIBRARIES_EXT
