# EF solver objs

EFMODOBJS = \
$(FQ_OBJ)/modules_feqis.o

EFOBJS = \
$(FQ_OBJ)/find_angle_ef.o \
$(FQ_OBJ)/feqis_main.o \
$(FQ_OBJ)/feqis_init.o \
$(FQ_OBJ)/build_2dgrid.o \
$(FQ_OBJ)/build_2dgrid2.o \
$(FQ_OBJ)/find_new_X0Y0.o \
$(FQ_OBJ)/PHI_EQ_2d_PBE.o \
$(FQ_OBJ)/solver_inversion_matrix_gsef.o

# Coupling scheme objs

# Make Commands
.PHONY: all
all: directories $(LIB) mvmod

.PHONY: directories
directories:
	@mkdir -p $(SP_OBJ)
	@mkdir -p $(FQ_OBJ)
	@mkdir -p $(LIB_DIR)
	@mkdir -p $(MOD_DIR)

.PHONY: mvmod
mvmod:
	rm -f *genmod.*
	-@mv *.mod $(MOD_DIR)/

.PHONY: clean
clean:
	rm -rf $(SP_OBJ)
	rm -rf $(FQ_OBJ)
	rm -f $(MOD_DIR)/*.mod
	rm -f *.mod
	rm -f $(LIB)

.PHONY: clean_sp
clean_sp:
	rm -f $(SP_OBJ)/*.o
	rm -f *genmod.mod
	rm -f $(LIB)

.PHONY: clean_ef
clean_ef:
	rm -f $(FQ_OBJ)/*.o
	rm -f *genmod.mod
	rm -f $(LIB)

# Rules

$(SP_OBJ)%.o : $(SP_SRC)%.f
	$(F90) $(SPFLAGS) -c $< -o $@

$(SP_OBJ)%.o : $(SP_SRC)%.f90
	$(F90) $(SPFLAGS) -c $< -o $@

$(FQ_OBJ)%.o : $(FQ_SRC)%.f90
	$(F90) $(FFLAGS) -c $< -o $@

$(LIB): $(SPMODOBJS) $(SPOBJS) $(EFMODOBJS) $(EFOBJS)
	ar -u -rv $(LIB) $(SPMODOBJS) $(SPOBJS) $(EFMODOBJS) $(EFOBJS)
