mkfile_path := $(abspath $(lastword $(MAKEFILE_LIST)))
EQ_DIR := $(dir $(mkfile_path))

SP_SRC = $(EQ_DIR)/SPIDER/src
SP_OBJ = $(EQ_DIR)/SPIDER/obj
FQ_SRC = $(EQ_DIR)/FEQIS/src
FQ_OBJ = $(EQ_DIR)/FEQIS/obj

LIB_DIR = $(EQ_DIR)/lib
MOD_DIR = $(EQ_DIR)/inc

F90    	= ifort
FFLAGS	= -O2 -g -traceback -warn all -I. -I$(MOD_DIR)
SPFLAGS	= -O2 -g -traceback -I$(MOD_DIR) -nostandard-realloc-lhs -qopenmp

# Target
LIBNAM = libequil.a
LIB = $(LIB_DIR)/$(LIBNAM)

# SPIDER objs

SPMODOBJS = \
