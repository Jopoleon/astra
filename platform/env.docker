#!/bin/bash

PKG=/opt/intel/oneapi
export I_MPI_ROOT=${PKG}/mpi/latest
export MKL_LIBDIR=${PKG}/mkl/latest/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/latest/linux/compiler/lib/intel64_lin
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export PATH=${PATH}:${COMP_BIN}
export FC=ifort
export CC="gcc -O"
export MPIFC=mpiifort
export MPICC=mpiicc
COMP_BIN=${PKG}/compiler/latest/linux/bin/intel64
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export ASTRA_EXT=/shares/departments/AUG/users/git/ASTRA_LIBRARIES_EXT
