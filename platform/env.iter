#!/bin/bash

source /etc/profile.d/modules.sh

PKG=/work/imas/opt/EasyBuild/software/
export I_MPI_ROOT=${PKG}/impi/2021.13.0-intel-compilers-2024.2.0/mpi/2021.13
export MKL_LIBDIR=${PKG}/imkl/2024.2.0/mkl/2024.2/lib
export COMP_LIBDIR=${PKG}/intel-compilers/2024.2.0/compiler/2024.2/lib
export LD_LIBRARY_PATH=${COMP_LIBDIR}:/work/imas/opt/EasyBuild/software//Python/3.11.5-GCCcore-13.2.0/lib
module load SciPy-bundle/2023.11-gfbf-2023b
echo $LD_LIBRARY_PATH
export FC=ifx
export CC=icx
export MPIFC=mpiifx
export MPICC=mpiicx
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

COMP_BIN=${PKG}/intel-compilers/2024.2.0/compiler/2024.2/bin
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export ASTRA_EXT=/home/ITER/tarding/ASTRA_LIBRARIES_EXT
