#!/bin/bash

PKG=/work/imas/opt/EasyBuild/software/
COMP_BIN=${PKG}/intel-compilers/2023.2.1/compiler/2023.2.1/linux/bin/intel64
export I_MPI_ROOT=${PKG}/impi/2021.10.0-intel-compilers-2023.2.1/mpi/2021.10.0
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/imkl/2023.2.0/mkl/2023.2.0/lib/intel64
export COMP_LIBDIR=${PKG}/intel-compilers/2023.2.1/compiler/2023.2.1/linux/lib
export LD_LIBRARY_PATH=${COMP_LIBDIR}
MPI_BIN=$I_MPI_ROOT/bin
PYTHON_BIN=/work/imas/opt/EasyBuild/software/Python/3.11.5-GCCcore-13.2.0/bin
if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]
then
    export PATH=${PYTHON_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$MPI_BIN:"* ]]
then
    export PATH=${MPI_BIN}:${PATH}
fi
export ASTRA_EXT=/home/ITER/tarding/ASTRA_LIBRARIES_EXT
export FC=ifort
export CC=gcc
export MPIFC=mpiifort
