 #!/bin/bash

module purge
module load python/3.12

export I_MPI_ROOT=/opt/intel/oneapi/mpi/2021.10.0/
export I_MPI_FABRICS=shm
export MKL_LIBDIR=/opt/intel/oneapi/mkl/2023.2.0/lib/intel64/
export COMP_LIBDIR=/opt/intel/oneapi/compiler/2023.2.0/linux/compiler/lib/intel64_lin
export COMP_LIBDIR=/opt/intel/oneapi/compiler/2023.2.1/linux/compiler/lib/intel64_lin

export LD_LIBRARY_PATH=${COMP_LIBDIR}:$LD_LIBRARY_PATH

MPI_BINDIR=$I_MPI_ROOT/bin
COMP_BINDIR=/opt/intel/compilers_and_libraries_2019.4.227/linux/bin/intel64
if [[ ":$PATH:" != *":$COMP_BINDIR:"* ]]
then
export PATH=${COMP_BINDIR}:${MPI_BINDIR}:${PATH}
fi

export ASTRA_EXT=/home/akadam/builds/A88_EXT
export PYTHON_BINDIR=/share/apps/python/3.12/bin/

export FC=ifort
export CC=icc
export MPIFC=mpiifort
export MPICC=mpiicc
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

# -- Slurm settings for tohtori, as of 22.10.25 --
# works on : gen04_epyc, gen05_skylake
# doesn't work on: gen04_broadwell, gen03_haswell, gen03_epyc, all
# due to rabbit compiling with -Xhost
export SL_QUEUE=gen05_skylake
export NODES=2
export CPUS=16
export TIME=02:00:00
