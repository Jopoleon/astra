#!/bin/bash

PKG=/opt/intel/oneapi
export I_MPI_ROOT=${PKG}/mpi/2021.18
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/2025.3/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2025.3/lib
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifx
export CC=icx
export MPIFC=mpiifx
export MPICC=mpiicx
COMP_BIN=${PKG}/compiler/2025.3/bin
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export PYTHON_BIN=/usr/bin

export ASTRA_EXT=/mnt/codes/astra/ASTRA_LIBRARIES_EXT
