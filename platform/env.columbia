#!/bin/bash

PKG=/opt/intel/oneapi
export I_MPI_ROOT=${PKG}/mpi/2021.16
export I_MPI_FABRICS=shm:ofi
export I_MPI_DEBUG=0
export I_MPI_LINK=opt
export MKL_LIBDIR=${PKG}/mkl/2025.2/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2025.2/lib
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FI_PROVIDER_PATH=$I_MPI_ROOT/libfabric/lib/prov
export FC=ifx
export CC=icx
export MPIFC=mpiifx
export MPICC=mpiicx
COMP_BIN=${PKG}/compiler/2025.2/bin
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export PYTHON_BIN=/usr/bin

export ASTRA_EXT=/mnt/homes/gtardini/ASTRA_LIBRARIES_EXT

export SL_QUEUE="p.tok
#SBATCH --qos=p.tok.48h"
