#!/bin/bash

PKG=/cineca/prod/opt/compilers/intel/pe-xe-2020/binary
COMP_BIN=${PKG}/compilers_and_libraries_2020/linux/bin/intel64
export I_MPI_ROOT=${PKG}/compilers_and_libraries/linux/mpi
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/lib/intel64
export COMP_LIBDIR=${PKG}/compilers_and_libraries/linux/lib/intel64
export INTEL_LICENSE_FILE=${PKG}/server.lic
export LD_LIBRARY_PATH=${COMP_LIBDIR}
MPI_BIN=$I_MPI_ROOT/intel64/bin
PYTHON_BIN=/afs/eufus.eu/user/g/g2gtardi/miniforge3/2024.09/bin
if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]
then
    export PATH=${PYTHON_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$MPI_BIN:"* ]]
then
    export PATH=${MPI_BIN}:${PATH}
fi

export ASTRA_EXT=/afs/eufus.eu/user/g/g2gtardi/ASTRA_LIBRARIES_EXT
export FC=ifort
export CC=gcc
export MPIFC=mpiifort
