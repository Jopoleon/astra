#!/bin/bash

module load cineca-modules/1.0 intel-oneapi-compilers/2024.1.0 intel-oneapi-mkl/2024.0.0--intel-oneapi-mpi--2021.12.1  

export MKL_LIBDIR=$MKLROOT/lib
export LD_LIBRARY_PATH=${MKL_LIBDIR}
export PYTHONHOME=/afs/eufus.eu/user/g/g2gtardi/miniforge3/2024.09
PYTHON_BIN=${PYTHONHOME}/bin
if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]
then
    export PATH=${PYTHON_BIN}:${PATH}
fi

export ASTRA_EXT=/afs/eufus.eu/user/g/g2gtardi/ASTRA_LIBRARIES_EXT
export FC=ifx
export CC=gcc
export MPIFC=mpiifx
