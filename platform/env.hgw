#!/bin/bash

PKG=/opt/intel/oneapi
COMP_BIN=${PKG}/compiler/2025.1/bin
export I_MPI_ROOT=${PKG}/mpi/2021.15
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/2025.1/lib/intel64 
export COMP_LIBDIR=${PKG}/compiler/2025.1/bin
export LD_LIBRARY_PATH=${COMP_LIBDIR}
MPI_BIN=$I_MPI_ROOT/bin
PYTHON_BIN=/home/IPP-HGW/papo/Schreibtisch/ASTRA/venv/bin
if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]
then
    export PATH=${PYTHON_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$MPI_BIN:"* ]]
then
    export PATH=${MPI_BIN}:${PATH}
fi
export ASTRA_EXT=~/ASTRA_LIBRARIES_EXT
export FC=ifx
export CC=/usr/bin/gcc
export MPIFC=mpiifort
