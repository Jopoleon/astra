#!/bin/bash

PKG=/opt/intel/oneapi
export I_MPI_ROOT=${PKG}/mpi/2021.15
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/2025.1/lib/intel64 
export COMP_LIBDIR=${PKG}/compiler/2025.1/bin
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifx
export CC=icx
export MPIFC=mpiifx
export MPICC=mpiicx
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

COMP_BINDIR=${PKG}/compiler/2025.1/bin
MPI_BINDIR=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BINDIR:"* ]]
then
    export PATH=${COMP_BINDIR}:${MPI_BINDIR}:${PATH}
fi

export PYTHON_BINDIR=/home/IPP-HGW/papo/Schreibtisch/ASTRA/venv/bin

export ASTRA_EXT=~/ASTRA_LIBRARIES_EXT
