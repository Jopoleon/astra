#!/bin/bash

PKG=/sw/intel/compilers_and_libraries_2018.3.222/linux
export I_MPI_ROOT=${PKG}/mpi
export MKL_LIBDIR=${PKG}/mkl/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/lib/intel64_lin
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifort
export CC=icc
export MPIFC=mpiifort
export MPICC=mpiicc
export INTEL_LICENSE_FILE="/compass/home/tardini/intel/licenses:/sw/intel/licenses:/opt/intel/licenses:/compass/home/fridrich/intel/licenses:/sw/intel/compilers_and_libraries_2018.3.222/linux/licenses:/opt/intel/licenses:/compass/home/fridrich/intel/licenses:/sw/intel/clck/2018.3/licenses:/opt/intel/licenses:/compass/home/fridrich/intel/licenses:/Users/Shared/Library/Application Support/Intel/Licenses"
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

COMP_BINDIR=${PKG}/bin/intel64
MPI_BINDIR=$I_MPI_ROOT/bin64
if [[ ":$PATH:" != *":$COMP_BINDIR:"* ]]
then
    export PATH=${COMP_BINDIR}:${MPI_BINDIR}:${PATH}
fi

export PYTHON_BINDIR==/compass/home/tardini/miniforge3/bin

export ASTRA_EXT=/compass/home/tardini/astra_ext
