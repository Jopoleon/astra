export MPIFC=mpiifort
export CC=/usr/bin/x86_64-linux-gnu-gcc-9
export INTEL_LICENSE_FILE="/compass/home/tardini/intel/licenses:/sw/intel/licenses:/opt/intel/licenses:/compass/home/fridrich/intel/licenses:/sw/intel/compilers_and_libraries_2018.3.222/linux/licenses:/opt/intel/licenses:/compass/home/fridrich/intel/licenses:/sw/intel/clck/2018.3/licenses:/opt/intel/licenses:/compass/home/fridrich/intel/licenses:/Users/Shared/Library/Application Support/Intel/Licenses"

export PYTHON_BIN==/compass/home/tardini/miniforge3/bin

export ASTRA_EXT=/compass/home/tardini/astra_ext
