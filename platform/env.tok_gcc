#!/bin/bash

source /etc/profile.d/modules.sh
module purge
module load gcc/14 mkl/2025.1

export I_MPI_ROOT=/mpcdf/soft/SLE_15/packages/x86_64/intel_oneapi/2025.1/mpi/2021.15
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${MKLROOT}/lib/intel64
export FC=gfortran
export CC=gcc
export MPIFC=mpifort
export MPICC=mpicc
export FC_FLAGS="-O0 -w -fPIC -fopenmp"
export LD_FLAGS="-fopenmp"

MPI_BINDIR=/mpcdf/soft/SLE_15/packages/znver4/impi/gcc_14-14.1.0/2021.15.0/bin
if [[ ":$PATH:" != *":$MPI_BINDIR:"* ]]
then
    export PATH=${MPI_BINDIR}:${PATH}
fi

export PYTHON_BINDIR=/mpcdf/soft/SLE_15/packages/x86_64/python-waterboa/2024.06/bin

export ASTRA_EXT=/tokp/work/software/TOK_2023/software/ASTRA_LIBRARIES_EXT

export SL_QUEUE="#SBATCH --partition=p.tok.openmp
#SBATCH --qos=p.tok.openmp.24h
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=128
#SBATCH --mem-per-cpu 1GB
#SBATCH --time=12:00:00

export OMP_NUM_THREADS=\${SLURM_CPUS_PER_TASK:-1}
export OMP_PLACES=cores
export OMP_PROC_BIND=close"
