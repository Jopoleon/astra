#!/bin/bash

XQUARTZ_HOME=/opt/X11
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${XQUARTZ_HOME}/lib"
export CPATH="${XQUARTZ_HOME}/include:${CPATH}"

BREW_PREFIX="$(brew --prefix)"

OPENBLAS_HOME="$(brew --prefix openblas)"
export OPENBLAS_LIBDIR="${OPENBLAS_HOME}/lib"
export OPENBLAS_INCLUDEDIR="${OPENBLAS_HOME}/include"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${OPENBLAS_LIBDIR}"

GCC_HOME="$(brew --prefix gcc)"
GCC_BINDIR="${GCC_HOME}/bin"
GFORTRAN_BIN="$(ls "${GCC_BINDIR}"/gfortran-[0-9]* 2>/dev/null | sort -V | tail -n 1)"
GCC_BIN="$(ls "${GCC_BINDIR}"/gcc-[0-9]* 2>/dev/null | sort -V | tail -n 1)"
export PATH="${PATH}:${GCC_BINDIR}"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${GCC_HOME}/lib/gcc/current"

OPENMPI_HOME="$(brew --prefix open-mpi)"
export OPENMPI_LIB="${OPENMPI_HOME}/lib"
export PATH="${PATH}:${OPENMPI_HOME}/bin"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${OPENMPI_HOME}/lib"

LIBOMP_HOME="$(brew --prefix libomp)"
export LIBOMP_LIB="${LIBOMP_HOME}/lib"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${LIBOMP_LIB}"

PYTHON_BIN="$(dirname "$(which python)")"

if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]; then
    export PATH=${COMP_BIN}:${I_MPI_ROOT}/bin:${PYTHON_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$MPI_BIN:"* ]]; then
    export PATH=${MPI_BIN}:${PATH}
fi

export ASTRA_EXT="${AWD}/astra_modules"

if [[ -n "$GFORTRAN_BIN" ]]; then
    export FC="$GFORTRAN_BIN"
else
    export FC=gfortran
fi
if [[ -n "$GCC_BIN" ]]; then
    export CC="$GCC_BIN"
else
    export CC=gcc
fi
if command -v mpif90 >/dev/null 2>&1; then
    export MPIFC=mpif90
else
    export MPIFC=mpifort
fi
export MPICC=mpicc
export FC_FLAGS="-O0 -w -fPIC -fopenmp"
export LD_FLAGS="-fopenmp"
