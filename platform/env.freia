#!/bin/bash

module purge

# Load Intel compilers and MPI
module load ifort/2020.3.110
module load openmpi/4.1.0
module load openmpi-devel/4.1.0

# Load Python 3.9 bundle (inc. numpy, scipy & json)
module use /common/software/micromamba/modules
module load python/3.9-minibundle

# Export variables required by ASTRA's build
export ASTRA_EXT=$HOME/ASTRA_LIBRARIES_EXT
export FC=ifort
export CC=gcc # Note that this is the "system" gcc, not provided by a module
export MPIFC=mpifort
export MKL_LIBDIR=$MKLROOT/lib/intel64_lin
