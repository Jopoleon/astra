#!/bin/bash

PKG=/opt/intel/oneapi
COMP_BIN=${PKG}/compiler/2024.2/bin
export I_MPI_ROOT=${PKG}/mpi/2024.2.0
export MKL_LIBDIR=${PKG}/mkl/2024.2/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2024.2/lib
NETCDF="-Wl,-rpath,/home/alfrodgon/netCDF/build/lib"
export LD_LIBRARY_PATH="${NETCDF}:${COMP_LIBDIR}"
export PATH=${PATH}:${COMP_BIN}

export ASTRA_EXT=/home/software/ASTRA/ASTRA_EXT_NEW
export FC="ifort -diag-disable=10448"
export CC="gcc -O"
export MPIFC="${I_MPI_ROOT}/bin/mpiifort -diag-disable=10448"
