#!/bin/bash -f

export ASTRA_EXT=/home/software/ASTRA/ASTRA_EXT_NEW
export MKL_LIBDIR=/opt/intel/oneapi/mkl/latest/lib/intel64
export COMP_LIBDIR=/opt/intel/oneapi/compiler/2024.2/lib
export AFC="ifort -diag-disable=10448"
export ACC="gcc -O"
export MPIFC="mpiifort -diag-disable=10448"
NETCDF="-Wl,-rpath,/home/alfrodgon/netCDF/build/lib"
INTEL_EXTRA="-Wl,-rpath,/opt/intel/oneapi/2024.2/lib"
export LD_LIBRARY_PATH="${NETCDF}:${INTEL_EXTRA}"
