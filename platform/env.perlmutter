#!/bin/bash

PKG=/opt/intel/oneapi
export I_MPI_ROOT=${PKG}/mpi/2021.10.0
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/2022.1.0/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2022.1.0/linux/compiler/lib/intel64
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifort
export MPIFC=mpiifort
export CC=/usr/bin/gcc-12
COMP_BIN=${PKG}/compiler/2022.1.0/linux/bin/intel64
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export PYTHON_BIN=/global/common/software/nersc/pe/conda-envs/24.1.0/python-3.11/nersc-python/bin

export ASTRA_EXT=/global/cfs/cdirs/m2116/ASTRA_LIBRARIES_EXT
