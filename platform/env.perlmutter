#!/bin/bash

PKG=/opt/intel/oneapi
COMP_BIN=${PKG}/compiler/2023.2.0/linux/bin
export I_MPI_ROOT=${PKG}/mpi/2021.10.0
export MKL_LIBDIR=${PKG}/mkl/2023.2.0/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2023.2.0/linux/compiler/lib/intel64_lin
export LD_LIBRARY_PATH=${COMP_LIBDIR}
MPI_BIN=$I_MPI_ROOT/bin
PYTHON_BIN=/global/common/software/nersc/pe/conda-envs/24.1.0/python-3.11/nersc-python/bin
if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]
then
    export PATH=${PYTHON_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$MPI_BIN:"* ]]
then
    export PATH=${MPI_BIN}:${PATH}
fi
export ASTRA_EXT=/global/homes/g/gtardini/ASTRA_LIBRARIES_EXT
export FC=ifx
export CC=icx
export MPIFC=mpiifx
