#!/bin/bash

PKG=/opt/intel/oneapi
COMP_BIN=${PKG}/compiler/latest/linux/bin/intel64
export I_MPI_ROOT=${PKG}/mpi/latest
export MKL_LIBDIR=${PKG}/mkl/latest/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/latest/lib/intel64
export LD_LIBRARY_PATH=${COMP_LIBDIR}
MPI_BIN=$I_MPI_ROOT/bin
PYTHON_BIN=...
if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]
then
    export PATH=${PYTHON_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$MPI_BIN:"* ]]
then
    export PATH=${MPI_BIN}:${PATH}
fi
export ASTRA_EXT=/global/homes/l/lleppin/ASTRA_LIBRARIES_EXT
export FC=ifort
export CC=icc
export MPIFC=mpiifort
