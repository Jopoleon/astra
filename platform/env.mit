#!/bin/bash

PKG=/orcd/software/community/001/rocky8/intel/2024.2.1
COMP_BIN=${PKG}/compiler/2024.2/bin
export I_MPI_ROOT=${PKG}/mpi/2021.13
export I_MPI_FABRICS=shm:tcp
export I_MPI_DEBUG=6
export I_MPI_LINK=opt
export I_MPI_SPAWN=on
export I_MPI_SHM=disable
export FI_PROVIDER_PATH=$I_MPI_ROOT/libfabric/lib/prov
export FI_PROVIDER=tcp
LIBFABRIC_DIR=$I_MPI_ROOT/libfabric/lib
export MKL_LIBDIR=${PKG}/mkl/2024.2/lib
export COMP_LIBDIR=${PKG}/compiler/2024.2/lib
export LD_LIBRARY_PATH=${COMP_LIBDIR}:${LIBFABRIC_DIR}

MPI_BIN=$I_MPI_ROOT/bin
PYTHON_BIN=/home/software/anaconda3/2023.07/bin
if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]
then
    export PATH=${PYTHON_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$MPI_BIN:"* ]]
then
    export PATH=${MPI_BIN}:${PATH}
fi
export ASTRA_EXT=/orcd/pool/003/pablorf_shared/ASTRA_LIBRARIES_EXT
export FC=ifort
export CC=/home/software/gcc/6.2.0/bin/gcc
export MPIFC=mpiifort
