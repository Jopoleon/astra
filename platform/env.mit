#!/bin/bash

PKG=/orcd/software/community/001/rocky8/intel/2024.2.1
export COMP_BIN=${PKG}/compiler/2024.2/bin
export I_MPI_ROOT=${PKG}/mpi/2021.13
export I_MPI_FABRICS=shm:ofi
export I_MPI_DEBUG=0
export I_MPI_LINK=opt
LIBFABRIC_DIR=$I_MPI_ROOT/libfabric/lib
export FI_PROVIDER_PATH=${LIBFABRIC_DIR}/prov
export MKL_LIBDIR=${PKG}/mkl/2024.2/lib
export COMP_LIBDIR=${PKG}/compiler/2024.2/lib
export LD_LIBRARY_PATH=${COMP_LIBDIR}:${LIBFABRIC_DIR}
export FC=ifx
export CC=icx
export MPIFC=mpiifx
export MPICC=mpiicx
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export PYTHON_BIN=/home/software/anaconda3/2023.07/bin

export ASTRA_EXT=/orcd/pool/003/pablorf_shared/code_repo/ASTRA_LIBRARIES_EXT

export SL_QUEUE=sched_mit_psfc_r8
