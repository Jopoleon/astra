#!/bin/bash -f

PKG=/home/software/intel/2021.3.0
IFORT_BIN=${PKG}/compiler/2021.3.0/linux/bin/intel64
export I_MPI_ROOT=${PKG}/mpi/2021.3.0
export MKL_LIBDIR=${PKG}/mkl/2021.3.0/lib/intel64
