#!/bin/bash

PKG=/home/software/intel/2021.3.0
COMP_BIN=${PKG}/compiler/2021.3.0/linux/bin/intel64
export I_MPI_ROOT=${PKG}/mpi/2021.3.0
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/2021.3.0/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2021.3.0/linux/compiler/lib/intel64
export LD_LIBRARY_PATH=${COMP_LIBDIR}
MPI_BIN=$I_MPI_ROOT/bin
PYTHON_BIN=/home/software/anaconda3/2023.07/bin
if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]
then
    export PATH=${PYTHON_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$MPI_BIN:"* ]]
then
    export PATH=${MPI_BIN}:${PATH}
fi
export ASTRA_EXT=/orcd/pool/003/pablorf_shared/ASTRA_LIBRARIES_EXT
export FC=ifort
export CC=/home/software/gcc/6.2.0/bin/gcc
export MPIFC=mpiifort
