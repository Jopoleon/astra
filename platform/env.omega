#!/bin/bash

PKG=/fusion/usc/opt/intel2020
export I_MPI_ROOT=/fusion/usc/opt/cst/CST_Studio_Suite_2022/MPI/Linux/IMPI2021U3
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/lib/intel64
export COMP_LIBDIR=${PKG}/compilers_and_libraries/linux/lib/intel64
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifort
export CC=icc
export MPIFC=mpifort
export MPICC=mpicc
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

COMP_BINDIR=${PKG}/compilers_and_libraries/linux/bin/intel64
MPI_BINDIR=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BINDIR:"* ]]
then
    export PATH=${COMP_BINDIR}:${MPI_BINDIR}:${PATH}
fi

export PYTHON_BINDIR=/fusion/projects/codes/conda/omega/envs_public/general/bin

export ASTRA_EXT=/fusion/projects/codes/astra/c8/8.2/intel2020/ASTRA_LIBRARIES_EXT
