#!/bin/bash

PKG=/fusion/usc/opt/intel2020
export I_MPI_ROOT=/fusion/usc/opt/mpich/mpich-3.2/intel2020
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/lib/intel64
export COMP_LIBDIR=${PKG}/compilers_and_libraries/linux/lib/intel64
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifort
export CC=/usr/bin/gcc
export MPIFC=mpifort
COMP_BIN=${PKG}/compilers_and_libraries/linux/bin/intel64
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export PYTHON_BIN=/fusion/projects/codes/conda/omega/envs_public/general/bin

export ASTRA_EXT=/fusion/projects/codes/astra/c8/8.2/intel2020/ASTRA_LIBRARIES_EXT
