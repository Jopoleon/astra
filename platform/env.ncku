#!/bin/bash -f

PKG=/opt/intel/oneapi
export MKL_LIBDIR=${PKG}/mkl/2024.2/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2024.2/lib
I_MPI_ROOT=${PKG}/mpi/2021.13
IFORT_BIN=${PKG}/compiler/2024.2/bin
MPIFORT_BIN=${I_MPI_ROOT}/bin
export PATH="${PATH}:${IFORT_BIN}:${MPIFORT_BIN}"
export AFC=ifort
export ACC="cc -O"
export MPIFC=mpiifort
export ASTRA_EXT=/home/astrainstaller/ASTRA_LIBRARIES_EXT
export LD_LIBRARY_PATH=$COMP_LIBDIR
