#!/bin/bash

PKG=/mpcdf/soft/SLE_15/packages/x86_64/intel_oneapi/2023.1
export I_MPI_ROOT=${PKG}/mpi/2021.9.0
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/2023.1.0/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2023.1.0/linux/compiler/lib/intel64
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifort
export CC=icc
export MPIFC=mpiifort
export MPICC=mpiicc
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

COMP_BIN=${PKG}/compiler/2023.1.0/linux/bin/intel64
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export PYTHON_BIN=/mpcdf/soft/SLE_15/packages/x86_64/anaconda/3/2023.03/bin

export ASTRA_EXT=/tokp/work/software/TOK_2023/software/ASTRA_LIBRARIES_EXT
