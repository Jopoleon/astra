#!/bin/bash

PKG=${HOME}/ipp-hgw/AStar3D/intel_tools/
export I_MPI_ROOT=${PKG}/mpi/2021.16
export I_MPI_FABRICS=shm
export MKL_LIBDIR=${PKG}/mkl/2025.2/lib/
export COMP_LIBDIR=${PKG}/compiler/2025.2/lib/
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifx
export CC=icx
export MPIFC=mpif90
export MPICC=mpiicx
COMP_BIN=${PKG}/compiler/2025.2/bin/
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export PYTHON_BIN=${HOME}/myenv/bin/python3
#export PYTHON_BIN=/usr/bin/python3

export ASTRA_EXT=${HOME}/ipp-hgw/AStar3D

export NETCDF_HOME=/usr/
export NETCDF_LIB='-L${NETCDF_HOME}/lib -lnetcdf -lnetcdff -Wl,-rpath,${NETCDF_HOME}/lib'

export LD_LIBRARY_PATH=${ASTRA_EXT}/intel_tools/mkl/2025.2/lib/:$LD_LIBRARY_PATH 
export LD_LIBRARY_PATH=${ASTRA_EXT}/hdf5/lib/:$LD_LIBRARY_PATH 
export LD_LIBRARY_PATH=${ASTRA_EXT}/netcdf-parallel/lib/:$LD_LIBRARY_PATH 
export LD_LIBRARY_PATH=${ASTRA_EXT}/intel_tools/mpi/2021.16/lib/:$LD_LIBRARY_PATH 

export MPI_COMMAND=" /usr/bin/mpirun -n "






