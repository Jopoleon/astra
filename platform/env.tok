#!/bin/bash

PKG=/mpcdf/soft/SLE_15/packages/x86_64/intel_oneapi/2025.1
COMP_BIN=${PKG}/compiler/2025.1/bin
export I_MPI_ROOT=${PKG}/mpi/2021.15
#export I_MPI_FABRICS=shm
export I_MPI_FABRICS=ofi,sockets,tcp
#export I_MPI_PMI_LIBRARY=$I_MPI_ROOT/lib/libpmi.so
export I_MPI_DEBUG=0
export I_MPI_LINK=opt
export MKL_LIBDIR=${PKG}/mkl/2025.1/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2025.1/lib
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export OMP_STACKSIZE=256M
export FI_PROVIDER_PATH=$I_MPI_ROOT/libfabric/lib/prov

MPI_BIN=$I_MPI_ROOT/bin
PYTHON_BIN=/mpcdf/soft/SLE_15/packages/x86_64/python-waterboa/2024.06/bin
if [[ ":$PATH:" != *":$PYTHON_BIN:"* ]]
then
    export PATH=${PYTHON_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${PATH}
fi
if [[ ":$PATH:" != *":$MPI_BIN:"* ]]
then
    export PATH=${MPI_BIN}:${PATH}
fi
export ASTRA_EXT=/tokp/work/software/TOK_2023/software/ASTRA_LIBRARIES_EXT
export FC=ifx
export CC=/mpcdf/soft/SLE_15/packages/x86_64/gcc/13.1.0/bin/gcc
#export CC=icx
export MPIFC=mpiifx
