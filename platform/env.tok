#!/bin/bash

PKG=/tok/u/system/soft/SLE_15/packages/x86_64/intel_oneapi/2025.1
export I_MPI_ROOT=${PKG}/mpi/2021.15
export I_MPI_FABRICS=shm
export MKLROOT=${PKG}/mkl/2025.1
export MKL_LIBDIR=${MKLROOT}/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2025.1/lib
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export FC=ifx
export CC=icx
export MPIFC=mpiifx
export MPICC=mpiicx
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

COMP_BIN=${PKG}/compiler/2025.1/bin
MPI_BIN=$I_MPI_ROOT/bin
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export PYTHON_BIN=/mpcdf/soft/SLE_15/packages/x86_64/python-waterboa/2024.06/bin

export ASTRA_EXT=/tokp/work/software/TOK_2023/software/ASTRA_LIBRARIES_EXT

export SL_QUEUE="#SBATCH --partition=p.tok.openmp
#SBATCH --qos=p.tok.openmp.24h
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=128
#SBATCH --mem-per-cpu 1GB
#SBATCH --time=12:00:00

export OMP_NUM_THREADS=\${SLURM_CPUS_PER_TASK:-1}
export OMP_PLACES=cores
export OMP_PROC_BIND=close"
