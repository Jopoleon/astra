#!/bin/bash -f

PKG=/mpcdf/soft/SLE_15/packages/x86_64/intel_oneapi/2023.1
IFORT_BIN=${PKG}/compiler/2023.1.0/linux/bin
export I_MPI_ROOT=${PKG}/mpi/2021.9.0
export MKL_LIBDIR=${PKG}/mkl/2023.1.0/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/2023.1.0/linux/compiler/lib/intel64
export LD_LIBRARY_PATH=${COMP_LIBDIR}
export PATH=${PATH}:${IFORT_BIN}

export ASTRA_EXT=/tokp/work/software/TOK_2023/software/ASTRA_LIBRARIES_EXT
export AFC=ifort
export ACC="cc -O"
export MPIFC=${I_MPI_ROOT}/bin/mpiifort
