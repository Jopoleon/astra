#!/bin/bash

PKG=/cluster/local/rh7/intel-2018u1/compilers_and_libraries_2018.1.163/linux
export I_MPI_ROOT=${PKG}/mpi
export MKL_LIBDIR=${PKG}/mkl/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/lib/intel64_lin
export LD_LIBRARY_PATH=${COMP_LIBDIR}:/home/tardini/soft/netCDF/build
export FC=ifort
export CC=icc
export MPIFC=mpiifort
export MPICC=mpiicc
export FC_FLAGS="-r8 -no-prec-div -traceback -O0 -w -fPIC -qopenmp"
export LD_FLAGS="-qopenmp -traceback"

COMP_BINDIR=${PKG}/bin/intel64
MPI_BINDIR=$I_MPI_ROOT/bin64
if [[ ":$PATH:" != *":$COMP_BINDIR:"* ]]
then
    export PATH=${COMP_BINDIR}:${MPI_BINDIR}:${PATH}
fi

export PYTHON_BINDIR=/usr/local/anaconda/3/201903/3.7.1/bin

export ASTRA_EXT=/home/tardini/ASTRA_LIBRARIES_EXT
