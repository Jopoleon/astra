#!/bin/bash

PKG=/cluster/local/rh7/intel-2018u1/compilers_and_libraries_2018.1.163/linux
export I_MPI_ROOT=${PKG}/mpi
export MKL_LIBDIR=${PKG}/mkl/lib/intel64
export COMP_LIBDIR=${PKG}/compiler/lib/intel64_lin
export LD_LIBRARY_PATH=${COMP_LIBDIR}:/home/tardini/soft/netCDF/build
export FC=ifort
export CC=icc
export MPIFC=mpiifort
export MPICC=mpiicc
COMP_BIN=${PKG}/bin/intel64
MPI_BIN=$I_MPI_ROOT/bin64
if [[ ":$PATH:" != *":$COMP_BIN:"* ]]
then
    export PATH=${COMP_BIN}:${MPI_BIN}:${PATH}
fi

export PYTHON_BIN=/usr/local/anaconda/3/201903/3.7.1/bin

export ASTRA_EXT=/home/tardini/ASTRA_LIBRARIES_EXT
