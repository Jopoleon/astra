		a_ratio=a_min_b/RTOR
		LL=0.2*GP*RTOR*li3r(roc)+0.4*GP*RTOR* &
     & ((1+1.81*sqrt(a_ratio)+2.05*a_ratio)* &
     & log(8./a_ratio)- &
     & (2.+9.25*sqrt(a_ratio)-1.21*sqrt(a_ratio)))* &
     & (1.-a_ratio)/(1.-a_ratio+0.73*sqrt(a_ratio)* &
     & (1.+2.*a_ratio**4.-6.*a_ratio**5.+3.7* &
     & a_ratio**6.))
		RR=22.5
		LL=LL/2.5d0 !*1.d0 !/2.5d0

	a_min_b=abc

		VV=-0.1*diohdt

!	write(*,*) VV,LL,RR,ipl_bf_bkdw,r_pl,z_pl
!	write(*,*) psitok(1,2),dccdt(1),psitok(11,2),dccdt(11)
!	write(*,*) psitok(12,2),dccdt(12)
!	call err_catch_a

		ipl_bf_bkdw=(LL*ipl_bf_bkdw+VV*TAU)/(LL+RR*TAU)
!	call err_catch_a
