! Namelist for VMEC-ASTRA-DKES stellarator simulation


&VMEC_TO_ASTRA_INPUTS
  ! Inputs for the Python vmec2astra script
  VMEC_WOUT_FILE = 'wout_VMECoutput.nc'
  BOOZER_FILE    = 'boozmn_VMECoutput.nc'
  VMEC_IN_FILE   = 'vmecinput.dat'
  VMEC_METRIC_FILE = 'vmec2astra.bin'
  VMEC_IN_TEMPLATE = 'vmecinput_template.dat'
  BOOZER_INFILE  = 'inboozer.dat'
  TRUE_SURF_FILE = 'true_surf.txt'
  VMEC_ROOT      = 'vmec'
  TEMPLATE_DIR   = 'templates'
  DATA_DIR       = 'dat'
/

&ASTRA_DKES_INTERFACE
  ! Inputs for the Fortran astra_dkes_interface_module
  DKES_FILE_PATH = 'dkes_combined.dat'
  VMEC_HEADER_FILE = 'vmec_header_data_VMECoutput.txt'
  B00_PROFILE_FILE = 'b00_profile_boozer_VMECoutput.txt' 
  MINOR_RADIUS_W7AS_FILE = 'minorradiusW7AS_VMECoutput.txt'
/

! The NGS pellet launch is in &pellet_ngs in exp/nml/<exp>: pel_vp,
! pel_chord_file, and either pel_theta/pel_phi with pel_ux/pel_uy/pel_uz or
! the two injector points pel_x0/pel_y0/pel_z0 and pel_x1/pel_y1/pel_z1.
