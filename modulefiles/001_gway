#%Module######################################################################
##
##      ASTRA modulefile
##      author: G. Tardini       (git@ipp.mpg.de)
##

module-whatis "ASTRA is a suite of transport codes"

proc ModulesHelp { } {
    puts stderr "See <https://www.aug.ipp.mpg.de/aug/manuals/astra/index.html>. "
}

conflict meld

if [ module-info mode load ] {
    module load cineca intel/pe-xe-2020--binary mkl/2020--binary intelmpi/2020--binary
}
if [ module-info mode remove ] {
    module unload cineca intel mkl intelmpi
}

setenv ASTRA_EXT /afs/eufus.eu/user/g/g2gtardi/ASTRA_LIBRARIES_EXT
setenv MKL_LIBDIR $env(MKLROOT)/lib/intel64
setenv COMP_LIBDIR $env(INTEL_HOME)/compilers_and_libraries/linux/lib/intel64
set NETCDF_HOME /cineca/prod/opt/libraries/netcdf/4.4.1/intel--pe-xe-2017--binary
set NETCDFF_HOME /cineca/prod/opt/libraries/netcdff/4.4.4/intel--pe-xe-2017--binary
set NETCDF_LIBDIR ${NETCDF_HOME}/lib
set NETCDFF_LIBDIR ${NETCDFF_HOME}/lib
setenv NETCDF_LIB "-L${NETCDF_LIBDIR} -lnetcdf -L${NETCDFF_LIBDIR} -lnetcdff -Wl,-rpath,${NETCDF_LIBDIR}:${NETCDFF_LIBDIR}"
setenv NETCDF_INC ${NETCDFF_HOME}/include

setenv AFC ifort
setenv ACC "cc -O"
setenv MPIFC mpiifort
setenv XLBR "-L/usr/lib64 -lX11 -Wl,--start-group $env(COMP_LIBDIR)/libintlc.so.5 $env(MKL_LIBDIR)/libmkl_intel_lp64.a $env(MKL_LIBDIR)/libmkl_core.a $env(MKL_LIBDIR)/libmkl_sequential.a $env(MKL_LIBDIR)/libmkl_blacs_intelmpi_lp64.a -Wl,--end-group"

set-alias ae exe/as_exe
