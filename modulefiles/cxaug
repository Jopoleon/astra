#%Module######################################################################
##
##      ASTRA modulefile
##      author: G. Tardini       (git@ipp.mpg.de)
##

module-whatis "ASTRA is a suite of transport codes"

proc ModulesHelp { } {
    puts stderr "See <https://gitlab.mpcdf.mpg.de/git/astra/-/wikis/The-ASTRA-code>. "
}

conflict meld

prereq intel
prereq mpi/2021.9.0
prereq compiler/2023.1.0
prereq mkl/2023.1.0

setenv ASTRA_EXT /shares/departments/AUG/users/git/ASTRA_LIBRARIES_EXT
set INTEL_HOME /shares/software/aug-dv/moduledata/Intel/oneapi
setenv MKL_LIBDIR $env(MKLROOT)/lib/intel64
setenv COMP_LIBDIR $INTEL_HOME/compiler/2023.1.0/linux/compiler/lib/intel64_lin

setenv AFC ifort
setenv ACC "cc -O"
setenv MPIFC mpiifort

set-alias ae exe/as_exe
