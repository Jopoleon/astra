#%Module######################################################################
##
##      ASTRA modulefile
##      author: G. Tardini       (git@ipp.mpg.de)
##

module-whatis "ASTRA is a suite of transport codes"

proc ModulesHelp { } {
    puts stderr "See <https://gitlab.mpcdf.mpg.de/git/astra/-/wikis/The-ASTRA-code>. "
}

conflict meld

if [ module-info mode load ] {
    module load intel/pe-xe-2018
    module load anaconda/3
}
if [ module-info mode remove ] {
    module unload intel/pe-xe-2018
    module unload anaconda/3
}

#setenv ASTRA_EXT /shares/departments/AUG/users/git/ASTRA_LIBRARIES_EXT
set INTEL_HOME /cluster/local/rh7/intel-2018u1
setenv ASTRA_EXT /home/tardini/ASTRA_LIBRARIES_EXT
setenv MKL_LIBDIR $INTEL_HOME/mkl/lib/intel64
setenv COMP_LIBDIR $INTEL_HOME/compilers_and_libraries/linux/lib/intel64_lin

setenv AFC ifort
setenv ACC "cc -O"
setenv MPIFC mpiifort

set-alias ae exe/as_exe
