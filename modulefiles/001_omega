#%Module######################################################################
##
##      ASTRA modulefile
##      author: G. Tardini       (git@ipp.mpg.de)
##

module-whatis "ASTRA is a suite of transport codes"

proc ModulesHelp { } {
    puts stderr "See <https://www.aug.ipp.mpg.de/aug/manuals/astra/index.html>. "
}

conflict meld

if [ module-info mode load ] {
    module load env/intel2020
}
if [ module-info mode remove ] {
    module unload env
}

setenv ASTRA_EXT /fusion/projects/astra/ASTRA_LIBRARIES_EXT
setenv MKL_LIBDIR $env(MKLROOT)/lib/intel64
setenv COMP_LIBDIR $env(MKLROOT)/../lib/intel64
set NETCDF_LIBDIR $env(NETCDF_DIR)/lib
setenv NETCDF_LIB "-L${NETCDF_LIBDIR} -lnetcdf -lnetcdff -Wl,-rpath,${NETCDF_LIBDIR}"
setenv NETCDF_INC $env(NETCDF_DIR)/include

setenv AFC ifort
setenv ACC "cc -O"
#setenv MPIFC mpiifort
setenv XLBR "-L/usr/lib64 -lX11 -Wl,--start-group $env(COMP_LIBDIR)/libintlc.so.5 $env(MKL_LIBDIR)/libmkl_intel_lp64.a $env(MKL_LIBDIR)/libmkl_core.a $env(MKL_LIBDIR)/libmkl_sequential.a $env(MKL_LIBDIR)/libmkl_blacs_intelmpi_lp64.a -Wl,--end-group"
