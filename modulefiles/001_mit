#%Module######################################################################
##
##      ASTRA modulefile
##      author: G. Tardini       (git@ipp.mpg.de)
##

module-whatis "ASTRA is a suite of transport codes"

proc ModulesHelp { } {
    puts stderr "See <https://www.aug.ipp.mpg.de/aug/manuals/astra/index.html>. "
}

conflict meld

if [ module-info mode load ] {
    module load intel/2021.3.0
    module load impi/2021.3.0
    module load anaconda3/2023.07
}
if [ module-info mode remove ] {
    module unload intel/2021.3.0
    module unload impi/2021.3.0
    module unload anaconda3/2023.07
}

setenv ASTRA_EXT /home/gtardini/ASTRA_LIBRARIES_EXT
setenv MKL_LIBDIR /home/software/intel/2021.3.0/mkl/2021.3.0/lib/intel64
setenv COMP_LIBDIR /home/software/intel/2021.3.0/compiler/2021.3.0/linux/compiler/lib/intel64

setenv AFC ifort
setenv ACC "cc -O"
setenv MPIFC mpiifort

set-alias ae exe/as_exe
