module-whatis "ASTRA is a suite of transport codes"

proc ModulesHelp { } {
    puts stderr "See <https://www.aug.ipp.mpg.de/aug/manuals/astra/index.html>. "
}

conflict meld
module use /home/software/modulefiles
if [ module-info mode load ] {
    module load intel/2021.3.0
    module load impi/2021.3.0
    module load anaconda3/2023.07
}
if [ module-info mode remove ] {
    module unload intel/2021.3.0
    module unload impi/2021.3.0
    module unload anaconda3/2023.07
}
