#%Module######################################################################
##
##      ASTRA modulefile
##      author: G. Tardini       (git@ipp.mpg.de)
##

module-whatis "ASTRA is a suite of transport codes"

proc ModulesHelp { } {
    puts stderr "See <https://www.aug.ipp.mpg.de/aug/manuals/astra/index.html>. "
}

conflict meld

set NETCDF_HOME $::env(NETCDF_C_ROOT)
set NETCDFF_HOME $::env(NETCDF_FORTRAN_ROOT)
set NETCDF_LIBDIR $NETCDF_HOME/lib
set NETCDFF_LIBDIR $NETCDFF_HOME/lib

setenv ASTRA_EXT /home/gtardini/ASTRA_LIBRARIES_EXT
setenv MKL_LIBDIR $::env(MKLROOT)/lib/intel64
setenv COMP_LIBDIR $::env(INTEL_ONEAPI_MKL_ROOT)/compiler/2023.1.0/linux/compiler/lib/intel64_lin
setenv NETCDF_LIB "-L${NETCDF_LIBDIR} -lnetcdf -L${NETCDFF_LIBDIR} -lnetcdff -Wl,-rpath,${NETCDF_LIBDIR}:${NETCDFF_LIBDIR}"
setenv NETCDF_INC $NETCDFF_HOME/include

setenv AFC ifort
setenv ACC "cc -O"
setenv MPIFC mpiifort
setenv XLBR "-L/usr/lib64 -lX11 -Wl,--start-group $comp_lib/libintlc.so.5 $mkllib/libmkl_intel_lp64.a $mkllib/libmkl_core.a $mkllib/libmkl_sequential.a $mkllib/libmkl_blacs_intelmpi_lp64.a -Wl,--end-group"

set-alias ae exe/as_exe
