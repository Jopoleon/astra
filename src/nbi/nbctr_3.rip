C	22-APR-2013						nbctr_3.rip
		YDT	=1./(JT2-JT1+1)
!
		YR2	=dSQRT(RJ*(RJ-RCR))
!!		YR2	=dSQRT((RJ+0.09)*(RJ+0.09-RCR))		!8.8s-8.38w [m]

	if(RCR.LT.RJT)	THEN
		YR1	=dSQRT(RJT*(RJT-RCR))
!===============================
		JI	=N1
	ELSE
		YR1	=0.
		JII	=(RJ-RCR)*YDYH
		JI	=II(JII)
	ENDIF
		YDY	=Y2-Y1
		YCDV	=DV*YDY

        do 	JE	=JBB,IEB
!====================
		YDYS	=F(JE,JN)*YDY
     		YS(JE)	=YS(JE)+YDYS
     		YDEX	=EXP(-YDYS)
 		YQBP	=YAQBP(JE)*YDEX
		YF0	=ARD(JE,JN)+AZ(JR)
!
		YFA	=YF0-ARD(JE,N1)
!!		YFA	=YF0-ARD(JE,N1)*1.17	!8.8s-8.38w [m]
		YDDD	=(YAQBP(JE)-YQBP)
	if(ARD(JE,JI).LT.YF0)	THEN		!	trapped
		JTRAP	=0
!	write(*,*) '0 trapped, j=',ji
	  if(YFA.LE.YR2.AND.YFA.GE.-YR2.or.rcr.ge.yriplr(ji))THEN !lost
!	write(*,*) 'trapped, lost j=',ji,jii
		YD	=0.
		YDCOS	=0.
		YTCOS	=YC2+YCT2(JE)
		YCT2(JE)=YC2
	  ELSE						! kept
!	write(*,*) 'trapped, lost j=',ji,jii

		YD	=YDDD
		YDCOS	=0.d0
!YD*YCT2(JE)
		YTCOS	=YC2+YCT2(JE)
		YCT2(JE)=YC2
	  ENDIF
	ELSE					!	passing
	  if(YFA.GE.YR1.AND.YFA.LE.YR2)	THEN	!	lost
!	write(*,*) 'passing, lost j=',ji

		YD	=0.
		YDCOS	=0.
		YTCOS	=YC2+YCT2(JE)
		YCT2(JE)=YC2
          ELSE					!	kept
!	write(*,*) 'passing, kept j=',ji

		YD	=YDDD
		YDCOS	=YD*(YC2+YCT2(JE))
		YTCOS	=YC2+YCT2(JE)
		YCT2(JE)=YC2
	  ENDIF					! end lost
	ENDIF					! end trapped
C    		YANBA(JE,JN1)=YANBA(JE,JN1)+YCDV*YAQBP(JE)
     		YANBA(JE,JN1)=YANBA(JE,JN1)+YDDD
!     		YATBA(JE,JN1)=YATBA(JE,JN1)+YDDD*YTCOS
!
    		YATBA(JE,JN1)=YATBA(JE,JN1)+2.*CONTR*YDDD*AZ(JR) !*2 in SCUBM
!!   		YATBA(JE,JN1)=YATBA(JE,JN1)-CONTR*YDDD*YTCOS
     		YAQBA(JE,JN1)=YAQBA(JE,JN1)+YD
	if(YTRAP(JN1).le.YTCOS)
     &     		YACBA(JE,JN1)=YACBA(JE,JN1)+YDCOS
     		YAQBP(JE)=YQBP
		YDYDT	=YD*YDT
	if(JTRAP.ne.0)	then 		!	passing (contr)
		do  	JT	=JT1,JT2
			YASBA1(JE,JN1,JT)	=YASBA(JE,JN1,JT)+YDYDT
		enddo
	else				! 	trapped
		do  	JT	=JT1,JT2
			YASBA(JE,JN1,JT)=YASBA(JE,JN1,JT)+0.5d0*YDYDT
			YASBA1(JE,JN1,JT)=YASBA1(JE,JN1,JT)+0.5d0*YDYDT
		enddo				!	end passing
	endif
	enddo
